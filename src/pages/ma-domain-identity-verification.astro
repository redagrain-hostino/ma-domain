<script>
  // FAQ Accordion (unchanged)
  document.querySelectorAll('.iv-faq-question').forEach(button => {
    button.addEventListener('click', () => {
      const item = button.parentElement;
      const answer = item.querySelector('.iv-faq-answer');
      const isActive = item.classList.contains('active');

      document.querySelectorAll('.iv-faq-item').forEach(otherItem => {
        if (otherItem !== item) {
          otherItem.classList.remove('active');
          otherItem.querySelector('.iv-faq-question').setAttribute('aria-expanded', 'false');
          otherItem.querySelector('.iv-faq-answer').hidden = true;
        }
      });

      if (isActive) {
        item.classList.remove('active');
        button.setAttribute('aria-expanded', 'false');
        answer.hidden = true;
      } else {
        item.classList.add('active');
        button.setAttribute('aria-expanded', 'true');
        answer.hidden = false;
      }
    });
  });

  // Scroll-triggered fade-in (unchanged — new dv- elements use .fade-in inside .iv-section)
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.style.animationPlayState = 'running';
          entry.target.classList.add('fade-in');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

    document.querySelectorAll('.iv-section .fade-in, .iv-cta-section .fade-in').forEach(el => {
      el.style.animationPlayState = 'paused';
      observer.observe(el);
    });
  });
</script>