---
// src/pages/identity-verification.astro
// ==========================================
// EXISTING LOGIC PRESERVED
// ==========================================
import Layout from '../layouts/Layout.astro';

const steps = [
  { number: '01', title: 'Choose Domain', desc: 'Select the .ma domain you want to register.' },
  { number: '02', title: 'Prepare Documents', desc: 'Gather your valid ID or company registration papers.' },
  { number: '03', title: 'ANRT Review', desc: 'Your information is securely reviewed by the ANRT.' },
  { number: '04', title: 'Activation', desc: 'Once approved, your domain is activated instantly.' }
];

const documents = {
  individuals: [
    { title: 'Moroccan National ID', desc: 'Clear, valid copy of your CIN (Recto/Verso).', icon: 'id' },
    { title: 'Passport', desc: 'Valid passport for non-resident Moroccan citizens.', icon: 'passport' }
  ],
  companies: [
    { title: 'Registre de Commerce', desc: 'Official company registration certificate (RC).', icon: 'building' },
    { title: 'IF & ICE', desc: 'Tax identification and common company identifier.', icon: 'file' }
  ]
};

// NEW: explanations + profile tags for the visual document section
const docExplanations = {
  cin: 'Used to verify the identity of an individual domain holder.',
  passport: 'May be used as an alternative identity document where applicable.',
  rc: 'Used to validate company registration information.',
  ice: 'Used to identify the registered business entity.'
};

const benefits = [
  { title: 'Security', desc: 'Protect domain ownership and prevent unauthorized takeovers.', icon: 'shield' },
  { title: 'Trust', desc: 'Maintain a reliable and credible .ma domain ecosystem.', icon: 'badge' },
  { title: 'Compliance', desc: 'Follow Moroccan ANRT domain registration regulations.', icon: 'scale' },
  { title: 'Protection', desc: 'Reduce fraudulent, abusive, or cybersquatting registrations.', icon: 'lock' }
];

const faqs = [
  { q: 'Why do I need to verify my identity?', a: 'The ANRT requires identity verification for all .ma domain registrations to ensure accountability, prevent fraud, and maintain the integrity of the Moroccan digital space.' },
  { q: 'What documents are accepted?', a: 'For individuals: A valid Moroccan National ID (CIN) or Passport. For companies: Recent Registre de Commerce (RC), Identifiant Fiscal (IF), and ICE documents.' },
  { q: 'How long does verification take?', a: 'Most verifications are processed within 24 to 48 business hours. Complex corporate structures may take up to 3 business days.' },
  { q: 'Can I register a .ma domain as a company?', a: 'Yes. You will need to provide the company\'s official registration documents and the identity of the legal representative.' }
];

const icons = {
  shield: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  badge: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/><path d="m9 12 2 2 4-4"/></svg>`,
  scale: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/></svg>`,
  lock: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`,
  alert: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>`,
  chevron: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>`
};
---

<Layout title="Identity Verification | .ma Domain Registration">
  <main class="iv-page">

    <!-- ========================================== -->
    <!-- HERO SECTION                               -->
    <!-- ========================================== -->
    <section class="iv-hero section" aria-labelledby="iv-hero-title">
      <div class="hero-decor" aria-hidden="true">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
      </div>

      <div class="container">
        <div class="hero-grid">
          <div class="hero-content">
            <div class="badge fade-in" style="--delay: 0.1s">
              <span class="badge-dot"></span>
              <span>ANRT Compliant Process</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>

            <h1 class="hero-title fade-in" id="iv-hero-title" style="--delay: 0.2s">
              Verify Your Identity for Your
              <span class="gradient-text">.ma Domain</span>
            </h1>

            <p class="hero-subtitle fade-in" style="--delay: 0.3s">
              To ensure security and compliance with Moroccan regulations, all .ma domain registrations require a brief, secure identity verification process.
            </p>

            <div class="secondary-links fade-in" style="--delay: 0.4s; margin-bottom: 1.5rem;">
              <a href="/register" class="btn-primary">
                <span>Start Verification</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <a href="/search" class="ghost-link">
                <span>Check Domain Availability</span>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M7 7h10v10"/></svg>
              </a>
            </div>

            <div class="trust-row fade-in" style="--delay: 0.5s">
              <div class="trust-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                <span>Secure & Encrypted</span>
              </div>
              <span class="trust-dot" aria-hidden="true"></span>
              <div class="trust-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                <span>Fast Processing</span>
              </div>
              <span class="trust-dot" aria-hidden="true"></span>
              <div class="trust-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                <span>ANRT Approved</span>
              </div>
            </div>
          </div>

          <div class="hero-visual fade-in" style="--delay: 0.3s" aria-hidden="true">
            <div class="visual-stack">
              <div class="showcase-card">
                <div class="showcase-header">
                  <span class="showcase-badge">Verified</span>
                  <span class="showcase-status">Approved</span>
                </div>
                <div class="showcase-domain" style="font-size: 1.5rem; margin-bottom: 1rem;">Identity Check</div>
                <div class="showcase-desc" style="display: flex; flex-direction: column; gap: 0.75rem;">
                  <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <div style="width: 32px; height: 32px; background: rgba(16, 185, 129, 0.1); border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #10b981;">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                    </div>
                    <span style="font-size: 0.875rem; color: var(--color-text);">Document validated</span>
                  </div>
                  <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <div style="width: 32px; height: 32px; background: rgba(81, 112, 255, 0.1); border-radius: 8px; display: flex; align-items: center; justify-content: center; color: var(--color-primary);">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    </div>
                    <span style="font-size: 0.875rem; color: var(--color-text);">ANRT compliance met</span>
                  </div>
                </div>
              </div>

              <div class="float-card float-1">
                <span class="mini-dot green"></span>
                <span class="mini-domain">CIN Verified</span>
              </div>
              <div class="float-card float-2">
                <span class="mini-dot green"></span>
                <span class="mini-domain">RC Approved</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- VERIFICATION PROCESS (4 Steps)             -->
    <!-- ========================================== -->
    <section class="iv-section">
      <div class="container">
        <div class="section-header fade-in" style="--delay: 0.1s">
          <h2>How Verification Works</h2>
          <p>A simple, secure, and transparent process to get your domain online.</p>
        </div>

        <div class="iv-steps-grid">
          {steps.map((step, index) => (
            <div class="iv-step-card fade-in" style={`--delay: ${0.2 + index * 0.1}s`}>
              <div class="step-number">{step.number}</div>
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- NEW: VISUAL DOCUMENT VERIFICATION SECTION                    -->
    <!-- ============================================================ -->
    <section class="iv-section dv-section iv-bg-alt">
      <div class="container">
        <div class="section-header fade-in" style="--delay: 0.1s">
          <h2>Documents Required for .ma Verification</h2>
          <p>Depending on your profile, ANRT may require identity or company documentation to validate your .ma domain registration.</p>
          <div class="dv-legend" aria-hidden="true">
            <span class="dv-legend-item"><span class="dv-dot dv-dot-ind"></span> Individuals</span>
            <span class="dv-legend-item"><span class="dv-dot dv-dot-com"></span> Companies</span>
          </div>
        </div>

        <!-- Verification pipeline -->
        <div class="dv-flow fade-in" style="--delay: 0.15s" aria-label="Verification flow: document submitted, identity check, ANRT verification, verified">
          <div class="dv-flow-step">
            <div class="dv-flow-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            </div>
            <span>DOCUMENT SUBMITTED</span>
          </div>
          <div class="dv-flow-line" aria-hidden="true"></div>
          <div class="dv-flow-step">
            <div class="dv-flow-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </div>
            <span>IDENTITY CHECK</span>
          </div>
          <div class="dv-flow-line" aria-hidden="true"></div>
          <div class="dv-flow-step">
            <div class="dv-flow-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <span>ANRT VERIFICATION</span>
          </div>
          <div class="dv-flow-line" aria-hidden="true"></div>
          <div class="dv-flow-step dv-flow-final">
            <div class="dv-flow-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <span>VERIFIED ✓</span>
          </div>
        </div>

        <!-- Bento document grid -->
        <div class="dv-bento">

          <!-- ===== CIN / ID CARD (hero) ===== -->
          <article class="dv-card dv-card-hero fade-in" style="--delay: 0.2s">
            <div class="dv-card-top">
              <span class="dv-tag dv-tag-ind">For individuals</span>
              <span class="dv-badge">Primary Document</span>
            </div>

            <div class="dv-stage">
              <div class="dv-scanline" aria-hidden="true"></div>
              <div class="dv-mockup dv-cin" role="img" aria-label="Sample preview of a Moroccan National ID card">
                <div class="cin-pattern" aria-hidden="true"></div>
                <div class="cin-holo" aria-hidden="true"></div>
                <div class="cin-header">
                  <div class="cin-emblem" aria-hidden="true">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2l2.5 5.5L20 8.5l-4 4 1 6-5-3-5 3 1-6-4-4 5.5-1z"/></svg>
                  </div>
                  <div class="cin-country">
                    <span>ROYAUME DU MAROC</span>
                    <span>KINGDOM OF MOROCCO</span>
                  </div>
                  <div class="cin-vcheck" aria-hidden="true">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                  </div>
                </div>
                <div class="cin-title">NATIONAL IDENTITY CARD</div>
                <div class="cin-body">
                  <div class="cin-photo" aria-hidden="true">
                    <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                  </div>
                  <div class="cin-fields">
                    <div class="cin-field"><span>ID NUMBER</span><strong>XXXX XXXX</strong></div>
                    <div class="cin-field"><span>NAME</span><strong>SAMPLE USER</strong></div>
                    <div class="cin-field"><span>DATE OF BIRTH</span><strong>XX/XX/XXXX</strong></div>
                    <div class="cin-field"><span>NATIONALITY</span><strong>MOROCCAN</strong></div>
                  </div>
                </div>
                <div class="cin-mrz" aria-hidden="true">XXXX&lt;&lt;SAMPLE&lt;USER&lt;&lt;&lt;&lt;&lt;&lt;XXXX&lt;&lt;&lt;&lt;</div>
              </div>
            </div>

            <div class="dv-status" aria-hidden="true">
              <span class="scan-idle">Preview Mode</span>
              <span class="scan-verifying">VERIFYING DOCUMENT…</span>
              <span class="scan-done">DOCUMENT FORMAT ✓</span>
            </div>

            <div class="dv-info">
              <h3>{documents.individuals[0].title} (CIN)</h3>
              <p>{docExplanations.cin}</p>
            </div>
          </article>

          <!-- ===== PASSPORT ===== -->
          <article class="dv-card dv-card-tall fade-in" style="--delay: 0.3s">
            <div class="dv-card-top">
              <span class="dv-tag dv-tag-ind">For individuals</span>
              <span class="dv-badge">Alternative</span>
            </div>

            <div class="dv-stage">
              <div class="dv-scanline" aria-hidden="true"></div>
              <div class="dv-mockup dv-passport" role="img" aria-label="Sample preview of a Moroccan passport">
                <div class="pp-frame" aria-hidden="true"></div>
                <div class="pp-top">ROYAUME DU MAROC</div>
                <div class="pp-emblem" aria-hidden="true">
                  <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="12" cy="12" r="10"/><path d="M12 4l1.8 4 4.2.4-3.2 2.9 1 4.2L12 17l-3.8 2.5 1-4.2-3.2-2.9 4.2-.4z"/></svg>
                </div>
                <div class="pp-word">PASSPORT</div>
                <div class="pp-sub">PASSEPORT</div>
                <div class="pp-bio" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 8h.01M12 8h5M7 12h10M7 16h6"/></svg>
                </div>
                <div class="pp-data">
                  <div class="pp-row"><span>No.</span><strong>XXXXXXX</strong></div>
                  <div class="pp-row"><span>NAME</span><strong>SAMPLE USER</strong></div>
                  <div class="pp-row"><span>DOB</span><strong>XX/XX/XXXX</strong></div>
                </div>
                <div class="pp-mrz" aria-hidden="true">P&lt;MARSAMPLE&lt;&lt;USER&lt;&lt;&lt;&lt;&lt;&lt;XXXX</div>
              </div>
            </div>

            <div class="dv-status" aria-hidden="true">
              <span class="scan-idle">Preview Mode</span>
              <span class="scan-verifying">VERIFYING DOCUMENT…</span>
              <span class="scan-done">DOCUMENT FORMAT ✓</span>
            </div>

            <div class="dv-info">
              <h3>{documents.individuals[1].title}</h3>
              <p>{docExplanations.passport}</p>
            </div>
          </article>

          <!-- ===== REGISTRE DE COMMERCE ===== -->
          <article class="dv-card fade-in" style="--delay: 0.25s">
            <div class="dv-card-top">
              <span class="dv-tag dv-tag-com">For companies</span>
              <span class="dv-badge">Required</span>
            </div>

            <div class="dv-stage">
              <div class="dv-scanline" aria-hidden="true"></div>
              <div class="dv-mockup dv-rc" role="img" aria-label="Sample preview of a Registre de Commerce certificate">
                <div class="rc-frame" aria-hidden="true"></div>
                <div class="rc-header">
                  <div class="rc-seal" aria-hidden="true">
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5.5"/><path d="M12 3v18M3 12h18"/></svg>
                  </div>
                  <div class="rc-title">REGISTRE DE COMMERCE</div>
                  <div class="rc-sub">TRIBUNAL DE COMMERCE</div>
                  <div class="rc-stamp" aria-hidden="true">VERIFIED ✓</div>
                </div>
                <div class="rc-rows">
                  <div class="rc-row"><span>Company</span><strong>SAMPLE COMPANY SARL</strong></div>
                  <div class="rc-row"><span>RC</span><strong>XXXXXXXX</strong></div>
                  <div class="rc-row"><span>ICE</span><strong>XXXXXXXXXXXXXXXX</strong></div>
                  <div class="rc-row"><span>Legal Form</span><strong>SARL</strong></div>
                  <div class="rc-row"><span>Status</span><strong class="rc-active">ACTIVE</strong></div>
                  <div class="rc-row"><span>Registration</span><strong>XX/XX/XXXX</strong></div>
                </div>
              </div>
            </div>

            <div class="dv-status" aria-hidden="true">
              <span class="scan-idle">Preview Mode</span>
              <span class="scan-verifying">VERIFYING DOCUMENT…</span>
              <span class="scan-done">DOCUMENT FORMAT ✓</span>
            </div>

            <div class="dv-info">
              <h3>{documents.companies[0].title}</h3>
              <p>{docExplanations.rc}</p>
            </div>
          </article>

          <!-- ===== ICE ===== -->
          <article class="dv-card fade-in" style="--delay: 0.35s">
            <div class="dv-card-top">
              <span class="dv-tag dv-tag-com">For companies</span>
              <span class="dv-badge">Required</span>
            </div>

            <div class="dv-stage">
              <div class="dv-scanline" aria-hidden="true"></div>
              <div class="dv-mockup dv-ice" role="img" aria-label="Sample preview of an ICE business identification document">
                <div class="ice-header">
                  <span class="ice-icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 8h4M7 12h10M7 16h7"/></svg>
                  </span>
                  <span class="ice-title">BUSINESS IDENTIFICATION</span>
                  <span class="ice-live">● ACTIVE</span>
                </div>
                <div class="ice-barcode" aria-hidden="true">
                  <svg width="100%" height="26" viewBox="0 0 200 26" preserveAspectRatio="none">
                    <g fill="currentColor"><rect x="0" width="2" height="26"/><rect x="5" width="1" height="26"/><rect x="9" width="3" height="26"/><rect x="15" width="1" height="26"/><rect x="19" width="2" height="26"/><rect x="24" width="1" height="26"/><rect x="28" width="3" height="26"/><rect x="34" width="2" height="26"/><rect x="39" width="1" height="26"/><rect x="43" width="2" height="26"/><rect x="48" width="3" height="26"/><rect x="54" width="1" height="26"/><rect x="58" width="2" height="26"/><rect x="63" width="1" height="26"/><rect x="67" width="3" height="26"/><rect x="73" width="2" height="26"/><rect x="78" width="1" height="26"/><rect x="82" width="2" height="26"/><rect x="87" width="3" height="26"/><rect x="93" width="1" height="26"/><rect x="97" width="2" height="26"/><rect x="102" width="1" height="26"/><rect x="106" width="3" height="26"/><rect x="112" width="2" height="26"/><rect x="117" width="1" height="26"/><rect x="121" width="2" height="26"/><rect x="126" width="3" height="26"/><rect x="132" width="1" height="26"/><rect x="136" width="2" height="26"/><rect x="141" width="1" height="26"/><rect x="145" width="3" height="26"/><rect x="151" width="2" height="26"/><rect x="156" width="1" height="26"/><rect x="160" width="2" height="26"/><rect x="165" width="3" height="26"/><rect x="171" width="1" height="26"/><rect x="175" width="2" height="26"/><rect x="180" width="1" height="26"/><rect x="184" width="3" height="26"/><rect x="190" width="2" height="26"/><rect x="195" width="1" height="26"/></g>
                  </svg>
                </div>
                <div class="ice-main">
                  <div class="ice-qr" aria-hidden="true">
                    <svg width="56" height="56" viewBox="0 0 11 11" shape-rendering="crispEdges">
                      <g fill="currentColor"><rect x="0" y="0" width="3" height="3"/><rect x="8" y="0" width="3" height="3"/><rect x="0" y="8" width="3" height="3"/><rect x="1" y="1" width="1" height="1" fill="#0f172a"/><rect x="9" y="1" width="1" height="1" fill="#0f172a"/><rect x="1" y="9" width="1" height="1" fill="#0f172a"/><rect x="4" y="0" width="1" height="1"/><rect x="5" y="2" width="1" height="1"/><rect x="4" y="4" width="1" height="1"/><rect x="6" y="5" width="1" height="1"/><rect x="2" y="5" width="1" height="1"/><rect x="5" y="7" width="1" height="1"/><rect x="8" y="6" width="1" height="1"/><rect x="10" y="8" width="1" height="1"/><rect x="6" y="9" width="1" height="1"/><rect x="4" y="10" width="1" height="1"/></g>
                    </svg>
                  </div>
                  <div class="ice-fields">
                    <div class="ice-field"><span>Company Name</span><strong>SAMPLE COMPANY</strong></div>
                    <div class="ice-field"><span>ICE</span><strong>XXXXXXXXXXXXXXXX</strong></div>
                    <div class="ice-field"><span>RC</span><strong>XXXXXXXX</strong></div>
