---
import Layout from '../layouts/Layout.astro';
import anrtLogo from '../assets/anrt-logo.png';
---

<Layout title="Register .ma Domain | Hostino">
    <main class="page-main min-h-screen">
        <div class="container">
            <!-- Hero Section -->
            <div class="register-hero-wrapper">
                <div class="hero-bg-blobs"></div>
                <section class="register-hero">
                    <h1 class="hero-title">Register Your .ma Domain</h1>
                    <p class="hero-subtitle">Secure your Moroccan online identity today. Fast, reliable, and affordable.</p>
                    
                    <div class="register-card card">
                        <form id="register-domain-form" action="https://mawhois.com/" method="GET" target="_blank" class="register-form">
                            <div class="input-wrapper">
                                <div class="input-group">
                                    <span class="www">www.</span>
                                    <input type="text" id="reg-domain-input" class="register-input" placeholder="your-next-big-idea" required autocomplete="off" spellcheck="false" />
                                    <input type="hidden" name="domain" id="reg-domain-full" />
                                    <div class="extension-divider"></div>
                                    <div class="custom-dropdown" id="domain-dropdown">
                                        <div class="dropdown-selected" id="dropdown-selected">
                                            <span>.ma</span>
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                                        </div>
                                        <div class="dropdown-menu" id="dropdown-menu">
                                            <div class="dropdown-item selected" data-value=".ma">.ma</div>
                                            <div class="dropdown-item" data-value=".co.ma">.co.ma</div>
                                            <div class="dropdown-item" data-value=".net.ma">.net.ma</div>
                                            <div class="dropdown-item" data-value=".org.ma">.org.ma</div>
                                            <div class="dropdown-item" data-value=".edu.ma">.edu.ma</div>
                                            <div class="dropdown-item" data-value=".ac.ma">.ac.ma</div>
                                            <div class="dropdown-item" data-value=".press.ma">.press.ma</div>
                                            <div class="dropdown-item" data-value=".gov.ma">.gov.ma</div>
                                        </div>
                                    </div>
                                    <input type="hidden" id="reg-ext-value" value=".ma" />
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary register-btn">
                                Search 
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-left:8px">
                                    <path d="M5 12h14M12 5l7 7-7 7"/>
                                </svg>
                            </button>
                        </form>
                        
                        <div class="form-features">
                            <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> Instant Setup</span>
                            <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> No Hidden Fees</span>
                            <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> 24/7 Support</span>
                        </div>
                    </div>
                </section>
            </div>
            
            <!-- Domain Extensions Cards Section -->
            <section class="extensions-section">
                <div class="extensions-header">
                    <h2 class="extensions-title">Choose Your Perfect Extension</h2>
                    <p class="extensions-subtitle">Find the right Moroccan domain suffix that perfectly matches your organization's purpose.</p>
                </div>
                
                <div class="extensions-grid">
                    <!-- .ma Card -->
                    <div class="ext-card card featured-card">
                        <div class="popular-badge">Most Used</div>
                        <div class="ext-header">
                            <h3 class="ext-name">.ma</h3>
                            <span class="ext-price">150 DH <span>/ year</span></span>
                        </div>
                        <p class="ext-desc">The standard choice for any Moroccan business, brand, or individual. Most popular and recognizable.</p>
                        <ul class="ext-features">
                            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> Best for general use</li>
                            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> High trust & visibility</li>
                        </ul>
                    </div>
                    
                    <!-- .co.ma Card -->
                    <div class="ext-card card">
                        <div class="ext-header">
                            <h3 class="ext-name">.co.ma</h3>
                            <span class="ext-price">150 DH <span>/ year</span></span>
                        </div>
                        <p class="ext-desc">Ideal for commercial entities, enterprises, and companies operating within Morocco.</p>
                        <ul class="ext-features">
                            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> For commercial entities</li>
                            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> Corporate identity</li>
                        </ul>
                    </div>
                    
                    <!-- .net.ma Card -->
                    <div class="ext-card card">
                        <div class="ext-header">
                            <h3 class="ext-name">.net.ma</h3>
                            <span class="ext-price">150 DH <span>/ year</span></span>
                        </div>
                        <p class="ext-desc">Perfect for internet service providers, IT companies, and network infrastructures.</p>
                        <ul class="ext-features">
                            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> For tech & networks</li>
                            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> IT industry standard</li>
                        </ul>
                    </div>
                    
                    <!-- .org.ma Card -->
                    <div class="ext-card card">
                        <div class="ext-header">
                            <h3 class="ext-name">.org.ma</h3>
                            <span class="ext-price">150 DH <span>/ year</span></span>
                        </div>
                        <p class="ext-desc">Dedicated to non-profit organizations, associations, and NGOs based in Morocco.</p>
                        <ul class="ext-features">
                            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> For organizations</li>
                            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> Non-profit specific</li>
                        </ul>
                    </div>
                    
                    <!-- .edu.ma Card -->
                    <div class="ext-card card">
                        <div class="ext-header">
                            <h3 class="ext-name">.edu.ma</h3>
                            <span class="ext-price">150 DH <span>/ year</span></span>
                        </div>
                        <p class="ext-desc">Reserved for recognized educational institutions, universities, and training centers.</p>
                        <ul class="ext-features">
                            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> For schools & universities</li>
                            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> Academic credibility</li>
                        </ul>
                    </div>
                    
                    <!-- .ac.ma Card -->
                    <div class="ext-card card">
                        <div class="ext-header">
                            <h3 class="ext-name">.ac.ma</h3>
                            <span class="ext-price">150 DH <span>/ year</span></span>
                        </div>
                        <p class="ext-desc">For higher education and academic research institutions in Morocco.</p>
                        <ul class="ext-features">
                            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> For higher education</li>
                            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> Research institutions</li>
                        </ul>
                    </div>

                    <!-- .press.ma Card -->
                    <div class="ext-card card">
                        <div class="ext-header">
                            <h3 class="ext-name">.press.ma</h3>
                            <span class="ext-price">150 DH <span>/ year</span></span>
                        </div>
                        <p class="ext-desc">Exclusively for accredited press, media organizations, and journalistic publications.</p>
                        <ul class="ext-features">
                            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> For media & press</li>
                            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> Official news source</li>
                        </ul>
                    </div>

                    <!-- .gov.ma Card -->
                    <div class="ext-card card">
                        <div class="ext-header">
                            <h3 class="ext-name">.gov.ma</h3>
                            <span class="ext-price">150 DH <span>/ year</span></span>
                        </div>
                        <p class="ext-desc">Strictly reserved for Moroccan governmental departments and official state institutions.</p>
                        <ul class="ext-features">
                            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> Government only</li>
                            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> State verification</li>
                        </ul>
                    </div>
                </div>
            </section>

            <!-- Process & Requirements Section -->
            <section class="process-section">
                <div class="process-container">
                    <div class="process-header">
                        <h2>Comment enregistrer un .ma ?</h2>
                        <p>Processus simple, rapide et conforme aux règles de l'ANRT.</p>
                    </div>
                    
                    <div class="process-steps">
                        <!-- Step 1 -->
                        <div class="step-card">
                            <div class="step-icon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                            </div>
                            <h3 class="step-title">1. Éligibilité & Documents</h3>
                            <p class="step-desc">Toute personne ou entreprise, au Maroc ou à l'étranger, peut enregistrer un .ma. Un justificatif suffit (CIN, RC, passeport ou Certificate of Incorporation).</p>
                        </div>
                        
                        <!-- Step 2 -->
                        <div class="step-card">
                            <div class="step-icon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                            </div>
                            <h3 class="step-title">2. Activation Instantanée</h3>
                            <p class="step-desc">Votre domaine est activé <strong>instantanément après le paiement</strong>. Commencez à l'utiliser sans attendre l'étude de votre dossier.</p>
                        </div>
                        
                        <!-- Step 3 -->
                        <div class="step-card">
                            <div class="step-icon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                            </div>
                            <h3 class="step-title">3. Vérification</h3>
                            <p class="step-desc">Vérification de vos documents sous 2 à 4 semaines, <strong>sans jamais bloquer l'usage</strong> de votre nom de domaine entre temps.</p>
                        </div>
                    </div>
                    
                    <div class="anrt-banner">
                        <div class="anrt-icon">
                            <img src={anrtLogo.src} alt="ANRT Logo" class="anrt-logo-img" />
                        </div>
                        <div class="anrt-text">
                            <strong>ANRT - Agence Nationale de Réglementation des Télécommunications</strong>
                            <span>Procédure conforme aux règles du registre .ma géré par l'ANRT.</span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Documents Requis Section -->
            <section class="docs-section">
                <div class="docs-container card">
                    <div class="docs-header">
                        <h2>Documents requis selon le type de titulaire</h2>
                        <p>Pour enregistrer un nom de domaine .ma, vous devez transmettre des pièces justificatives selon votre statut. La vérification administrative peut prendre 2 à 4 semaines ouvrées - <strong>sans bloquer l'usage : le domaine est activé instantanément.</strong></p>
                    </div>
                    
                    <div class="docs-list">
                        <!-- Particulier -->
                        <div class="doc-item">
                            <div class="doc-type">
                                <div class="doc-icon">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                </div>
                                <h3>Particulier <span>(Maroc)</span></h3>
                            </div>
                            <div class="doc-req">
                                <p>Carte Nationale d'Identité (CIN)</p>
                            </div>
                        </div>
                        
                        <!-- Entreprise -->
                        <div class="doc-item">
                            <div class="doc-type">
                                <div class="doc-icon">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                                </div>
                                <h3>Entreprise <span>(Maroc)</span></h3>
                            </div>
                            <div class="doc-req">
                                <p>Registre de Commerce (RC – Modèle 7, daté de moins de 3 mois)</p>
                            </div>
                        </div>
                        
                        <!-- Etranger -->
                        <div class="doc-item">
                            <div class="doc-type">
                                <div class="doc-icon">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                                </div>
                                <h3>Titulaire étranger</h3>
                            </div>
                            <div class="doc-req">
                                <p>Passeport ou Certificate of Incorporation</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>
</Layout>

<style>
    .page-main {
        padding-top: 6rem;
        padding-bottom: 6rem;
        min-height: calc(100vh - 80px);
    }
    
    .register-hero-wrapper {
        position: relative;
        background: linear-gradient(180deg, rgba(81, 112, 255, 0.08) 0%, rgba(255, 255, 255, 0.4) 100%);
        border: 1px solid rgba(81, 112, 255, 0.15);
        border-radius: 40px;
        padding: 4rem 2rem 5rem 2rem;
        margin-bottom: 4rem;
        /* Removed overflow: hidden here so dropdown is not clipped */
    }
    
    .hero-bg-blobs {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        overflow: hidden;
        border-radius: 40px;
        z-index: 0;
        pointer-events: none;
    }
    
    /* Subtle decorative blobs in the background wrapper */
    .hero-bg-blobs::before {
        content: '';
        position: absolute;
        top: -100px;
        left: -100px;
        width: 300px;
        height: 300px;
        background: radial-gradient(circle, rgba(81,112,255,0.15) 0%, rgba(255,255,255,0) 70%);
        border-radius: 50%;
    }
    
    .hero-bg-blobs::after {
        content: '';
        position: absolute;
        bottom: -50px;
        right: -50px;
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(16,185,129,0.08) 0%, rgba(255,255,255,0) 70%);
        border-radius: 50%;
    }

    .register-hero {
        position: relative;
        z-index: 10;
        text-align: center;
        max-width: 900px;
        margin: 0 auto;
    }

    .hero-title {
        font-size: 4rem;
        font-weight: 700;
        color: var(--color-text);
        letter-spacing: -0.03em;
        margin-bottom: 1.5rem;
        line-height: 1.1;
    }

    .hero-title span {
        background: linear-gradient(135deg, var(--color-primary), #738aff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .hero-subtitle {
        font-size: 1.25rem;
        color: var(--color-text-muted);
        margin-bottom: 3.5rem;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
        line-height: 1.6;
    }

    .register-card {
        padding: 4rem;
        box-shadow: 0 24px 50px -12px rgba(81, 112, 255, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.8);
        border-radius: 32px;
        background: rgba(255, 255, 255, 0.85);
    }

    .register-form {
        display: flex;
        gap: 1rem;
        align-items: center;
    }

    .input-wrapper {
        flex: 1;
        position: relative;
    }

    .input-group {
        display: flex;
        align-items: center;
        border: 2px solid var(--color-border);
        border-radius: 9999px;
        padding: 0.5rem 1.5rem;
        background: white;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        height: 72px;
    }

    .input-group:focus-within {
        border-color: var(--color-primary);
        box-shadow: 0 0 0 4px rgba(81, 112, 255, 0.15), 0 10px 30px -10px rgba(81, 112, 255, 0.2);
        transform: translateY(-2px);
    }

    .www {
        color: var(--color-text-muted);
        font-weight: 500;
        font-size: 1.25rem;
        user-select: none;
    }

    .custom-dropdown {
        position: relative;
        font-family: inherit;
    }
    
    .dropdown-selected {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0 0.5rem 0 0.75rem;
        color: var(--color-primary);
        font-weight: 700;
        font-size: 1.25rem;
        cursor: pointer;
        transition: color 0.2s ease;
        user-select: none;
    }
    
    .dropdown-selected:hover {
        color: #3d5be6;
    }
    
    .dropdown-selected svg {
        transition: transform 0.2s ease;
    }
    
    .custom-dropdown.open .dropdown-selected svg {
        transform: rotate(180deg);
    }
    
    .dropdown-menu {
        position: absolute;
        top: calc(100% + 15px);
        right: 0;
        background: white;
        border-radius: 16px;
        box-shadow: 0 10px 40px -10px rgba(2, 37, 69, 0.15), 0 0 0 1px rgba(81, 112, 255, 0.1);
        padding: 0.5rem;
        min-width: 140px;
        z-index: 50;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-10px);
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }
    
    .custom-dropdown.open .dropdown-menu {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }
    
    .dropdown-item {
        padding: 0.65rem 1rem;
        border-radius: 8px;
        cursor: pointer;
        font-size: 1.125rem;
        font-weight: 500;
        color: var(--color-text);
        transition: background 0.2s ease, color 0.2s ease;
        text-align: left;
    }
    
    .dropdown-item:hover, .dropdown-item.selected {
        background: #f5f8ff;
        color: var(--color-primary);
        font-weight: 600;
    }

    .register-input {
        flex: 1;
        border: none;
        outline: none;
        padding: 0 0.5rem;
        font-size: 1.35rem;
        font-weight: 600;
        color: var(--color-text);
        width: 100%;
        background: transparent;
    }
    
    .register-input::placeholder {
        color: #cbd5e1;
        font-weight: 400;
    }

    .register-btn {
        height: 72px;
        padding: 0 3rem;
        font-size: 1.25rem;
        font-weight: 600;
        border-radius: 9999px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    
    .form-features {
        display: flex;
        justify-content: center;
        gap: 2rem;
        margin-top: 2rem;
    }
    
    .form-features span {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        color: var(--color-text-muted);
        font-weight: 500;
    }

    @media (max-width: 768px) {
        .hero-title {
            font-size: 2.75rem;
        }
        .register-card {
            padding: 2rem;
        }
        .register-form {
            flex-direction: column;
        }
        .input-group, .register-btn {
            height: 64px;
        }
        .register-btn {
            width: 100%;
        }
        .form-features {
            flex-direction: column;
            gap: 1rem;
            align-items: center;
        }
        .extensions-grid {
            grid-template-columns: 1fr;
        }
    }
    
    /* ============ EXTENSIONS CARDS CSS ============ */
    .extensions-section {
        margin-top: 2rem;
    }
    
    .extensions-header {
        text-align: center;
        margin-bottom: 3rem;
    }
    
    .extensions-title {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--color-text);
        margin-bottom: 1rem;
    }
    
    .extensions-subtitle {
        font-size: 1.125rem;
        color: var(--color-text-muted);
        max-width: 600px;
        margin: 0 auto;
    }
    
    .extensions-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
    }
    
    .ext-card {
        position: relative;
        padding: 2.5rem 2rem;
        display: flex;
        flex-direction: column;
        border: 1px solid rgba(81, 112, 255, 0.1);
        background: rgba(255, 255, 255, 0.6);
        transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    }
    
    .featured-card {
        border: 2px solid var(--color-primary);
        background: rgba(255, 255, 255, 0.9);
        box-shadow: 0 10px 30px -10px rgba(81, 112, 255, 0.15);
    }
    
    .popular-badge {
        position: absolute;
        top: -12px;
        right: 20px;
        background: linear-gradient(135deg, var(--color-primary), #738aff);
        color: white;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.35rem 1rem;
        border-radius: 9999px;
        box-shadow: 0 4px 12px rgba(81, 112, 255, 0.3);
    }
    
    .ext-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px -15px rgba(81, 112, 255, 0.2);
        border-color: rgba(81, 112, 255, 0.3);
    }
    
    .ext-header {
        display: flex;
        justify-content: space-between;
