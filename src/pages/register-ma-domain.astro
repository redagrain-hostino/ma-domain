<script>
    const form = document.getElementById('register-domain-form') as HTMLFormElement;
    const input = document.getElementById('reg-domain-input') as HTMLInputElement;
    const hidden = document.getElementById('reg-domain-full') as HTMLInputElement;
    
    // Custom Dropdown Logic
    const dropdown = document.getElementById('domain-dropdown');
    const selectedDisplay = document.querySelector('#dropdown-selected span');
    const extValueInput = document.getElementById('reg-ext-value') as HTMLInputElement;
    const dropdownItems = document.querySelectorAll('.dropdown-item');

    if (dropdown && selectedDisplay && extValueInput) {
        // Toggle dropdown
        document.getElementById('dropdown-selected')?.addEventListener('click', (e) => {
            e.stopPropagation();
            dropdown.classList.toggle('open');
        });

        // Handle item selection
        dropdownItems.forEach(item => {
            item.addEventListener('click', (e) => {
                e.stopPropagation();
                const value = item.getAttribute('data-value');
                if (value) {
                    selectedDisplay.textContent = value;
                    extValueInput.value = value;
                }
                
                // Update active state
                dropdownItems.forEach(i => i.classList.remove('selected'));
                item.classList.add('selected');
                
                dropdown.classList.remove('open');
            });
        });

        // Close on outside click
        document.addEventListener('click', (e) => {
            if (!dropdown.contains(e.target as Node)) {
                dropdown.classList.remove('open');
            }
        });
    }

    if (form && input && hidden && extValueInput) {
        form.addEventListener('submit', (e) => {
            let domain = input.value.trim().toLowerCase();
            if (!domain.includes('.')) {
                domain = domain + extValueInput.value;
            }
            hidden.value = domain;
        });
    }
</script>
