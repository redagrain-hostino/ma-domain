---
// src/components/domain-generator/DomainGeneratorHero.astro
interface Props {
  initialExtensions?: string[];
}

const { initialExtensions = ['.ma'] } = Astro.props;

const examples = [
  'casablanca-food',
  'tech-startup',
  'morocco-fashion',
];

const steps = [
  {
    title: 'Find your keywords',
    description: 'Identify the core terms that define your brand and business.'
  },
  {
    title: 'Use the AI generator',
    description: 'Let our AI create unique, brandable domain suggestions based on your keywords.'
  },
  {
    title: 'Select and secure instantly',
    description: 'Choose your favorite domain and register it immediately with real-time availability check.'
  },
  {
    title: 'Launch your idea',
    description: 'Ready for the next step? Easily build a website, purchase hosting, or set up a professional email – all from your Hostinger account.',
    expanded: true
  }
];

import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
<section class="dgh-hero" aria-labelledby="dgh-title">
  <!-- Decorative orbs -->
  <div class="dgh-decor" aria-hidden="true">
    <div class="dgh-orb dgh-orb-1"></div>
    <div class="dgh-orb dgh-orb-2"></div>
  </div>

  <div class="dgh-container">
    <!-- Badge -->
    <div class="dgh-badge">
      <span class="dgh-badge-dot"></span>
      <span>AI-Powered Domain Generator</span>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3L12 3Z"/>
      </svg>
    </div>

    <!-- Title -->
    <h1 class="dgh-title" id="dgh-title">
      Find your <span class="dgh-gradient-text">perfect domain name</span>
    </h1>

    <p class="dgh-subtitle">
      Enter your idea or brand name and let AI find the best available extensions for you.
    </p>

    <!-- Premium AI Input Card -->
    <div class="dgh-input-card">
      <div class="dgh-input-inner">
        <div class="dgh-input-row">
          <div class="dgh-sparkle-box" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3L12 3Z"/>
            </svg>
          </div>
          <input
            id="domain-input"
            type="text"
            placeholder="Enter your idea (e.g., casablanca-food)"
            aria-label="Desired domain name"
            class="dgh-main-input"
            autocomplete="off"
          />
        </div>

        <div class="dgh-input-footer">
          <!-- Extension selector -->
          <div class="dgh-ext-group" role="group" aria-label="Domain extensions">
            <span class="dgh-ext-label">Extensions</span>
            {initialExtensions.map((ext) => (
              <button type="button" class="ext-btn" data-ext={ext} aria-pressed="false">
                {ext}
              </button>
            ))}
          </div>

          <!-- Generate CTA -->
          <button id="generate-btn" class="dgh-generate-btn" type="button">
            <span class="dgh-btn-spinner" aria-hidden="true"></span>
            <span class="dgh-btn-text">Generate Domains</span>
            <span class="dgh-btn-loading-text" aria-hidden="true">Generating...</span>
            <svg class="dgh-btn-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Example prompts -->
    <div class="dgh-examples">
      <span class="dgh-examples-label">Try:</span>
      {examples.map((ex) => (
        <button type="button" class="dgh-example" data-example={ex}>
          {ex}
        </button>
      ))}
    </div>

    <!-- Trust row -->
    <div class="dgh-trust-row">
      <div class="dgh-trust-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
        </svg>
        <span>Real-time availability</span>
      </div>
      <span class="dgh-trust-dot" aria-hidden="true"></span>
      <div class="dgh-trust-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M20 6L9 17l-5-5"/>
        </svg>
        <span>AI brand analysis</span>
      </div>
      <span class="dgh-trust-dot" aria-hidden="true"></span>
      <div class="dgh-trust-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <span>Instant secure checkout</span>
      </div>
    </div>
  </div>
</section>

<!-- Results Section (Hidden by default, shown after generation) -->
<section id="results-section" class="dgh-results-section" hidden>
  <div class="dgh-results-container">
    <div class="dgh-results-header">
      <h2 class="dgh-results-title">
        Available Domain <span class="dgh-gradient-text">Suggestions</span>
      </h2>
      <p class="dgh-results-subtitle">
        We found these perfect matches for your brand. Click to register instantly.
      </p>
    </div>
    
    <div class="dgh-results-list" id="results-list">
      <!-- Results will be injected here by JS -->
    </div>
    
    <div class="dgh-results-footer">
      <p class="dgh-results-note">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="16" x2="12" y2="12"/>
          <line x1="12" y1="8" x2="12.01" y2="8"/>
        </svg>
        All domains include free SSL certificate, DNS management, and 24/7 support
      </p>
    </div>
  </div>
</section>

<!-- Steps Section -->
<section class="dgh-steps-section">
  <div class="dgh-steps-container">
    <div class="dgh-steps-badge">
      <span>TIPS</span>
    </div>
    
    <h2 class="dgh-steps-title">
      Generate the best domain names in <span class="dgh-gradient-text">4 steps</span>
    </h2>

    <div class="dgh-steps-list">
      {steps.map((step, index) => (
        <div class={`dgh-step-item ${step.expanded ? 'expanded' : ''}`} data-step={index}>
          <button 
            class="dgh-step-header" 
            type="button"
            aria-expanded={step.expanded ? 'true' : 'false'}
            aria-controls={`step-content-${index}`}
          >
            <span class="dgh-step-number">{index + 1}.</span>
            <span class="dgh-step-title-text">{step.title}</span>
            <svg 
              class="dgh-step-icon" 
              width="20" 
              height="20" 
              viewBox="0 0 24 24" 
              fill="none" 
              stroke="currentColor" 
              stroke-width="2"
              aria-hidden="true"
            >
              <path d={step.expanded ? "M18 15l-6-6-6 6" : "M6 9l6 6 6-6"} />
            </svg>
          </button>
          
          <div 
            id={`step-content-${index}`}
            class="dgh-step-content"
            role="region"
            aria-labelledby={`step-header-${index}`}
          >
            <p class="dgh-step-description">{step.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<Footer/>
</Layout>

<style>
  /* ============ HERO ============ */
  .dgh-hero {
    --dgh-primary: #5170ff;
    --dgh-primary-light: #738aff;
    --dgh-purple: #8b5cf6;
    --dgh-pink: #ec4899;
    --dgh-text: #0f172a;
    --dgh-muted: #64748b;
    --dgh-success: #10b981;
    --dgh-warning: #f59e0b;

    position: relative;
    padding: 5rem 1.5rem 4rem;
    overflow: hidden;
  }

  .dgh-decor {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .dgh-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.45;
    animation: dgh-float 18s ease-in-out infinite;
  }

  .dgh-orb-1 {
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, hsla(229, 100%, 75%, 0.45) 0%, transparent 70%);
    top: -180px;
    left: -120px;
  }

  .dgh-orb-2 {
    width: 460px;
    height: 460px;
    background: radial-gradient(circle, hsla(280, 100%, 80%, 0.4) 0%, transparent 70%);
    bottom: -160px;
    right: -120px;
    animation-delay: -9s;
  }

  @keyframes dgh-float {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(30px, -25px) scale(1.06); }
  }

  .dgh-container {
    position: relative;
    z-index: 1;
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  /* ============ BADGE ============ */
  .dgh-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(81, 112, 255, 0.15);
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--dgh-primary);
    margin-bottom: 1.75rem;
  }

  .dgh-badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--dgh-primary);
    box-shadow: 0 0 0 4px rgba(81, 112, 255, 0.15);
    animation: dgh-pulse 2.5s ease-in-out infinite;
  }

  @keyframes dgh-pulse {
    0%, 100% { box-shadow: 0 0 0 4px rgba(81, 112, 255, 0.15); }
    50% { box-shadow: 0 0 0 8px rgba(81, 112, 255, 0); }
  }

  /* ============ TITLE ============ */
  .dgh-title {
    font-size: clamp(2.25rem, 5.5vw, 3.75rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--dgh-text);
    margin: 0 0 1.25rem;
  }

  .dgh-gradient-text {
    background: linear-gradient(135deg, var(--dgh-primary) 0%, var(--dgh-purple) 50%, var(--dgh-pink) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .dgh-subtitle {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--dgh-muted);
    max-width: 560px;
    margin: 0 auto 2.5rem;
  }

  /* ============ INPUT CARD ============ */
  .dgh-input-card {
    position: relative;
    border-radius: 24px;
    padding: 1.5px;
    background: linear-gradient(135deg, rgba(81, 112, 255, 0.35), rgba(139, 92, 246, 0.35), rgba(236, 72, 153, 0.35));
    box-shadow: 0 12px 40px rgba(31, 38, 135, 0.08);
    transition: box-shadow 0.4s ease;
    text-align: left;
  }

  .dgh-input-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, var(--dgh-primary), var(--dgh-purple), var(--dgh-pink));
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .dgh-input-card:focus-within {
    box-shadow: 0 0 0 6px rgba(81, 112, 255, 0.1), 0 20px 60px rgba(81, 112, 255, 0.2);
  }

  .dgh-input-card:focus-within::before {
    opacity: 1;
  }

  .dgh-input-inner {
    position: relative;
    z-index: 1;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 22.5px;
    padding: 1.25rem;
  }

  .dgh-input-row {
    display: flex;
    gap: 0.875rem;
    align-items: center;
  }

  .dgh-sparkle-box {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(81, 112, 255, 0.12), rgba(139, 92, 246, 0.12));
    color: var(--dgh-purple);
  }

  .dgh-main-input {
    flex: 1;
    width: 100%;
    background: transparent;
    border: none;
    outline: none;
    font-family: inherit;
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--dgh-text);
    padding: 0.5rem 0;
    min-height: 42px;
  }

  .dgh-main-input::placeholder {
    color: var(--dgh-muted);
    opacity: 0.7;
  }

  .dgh-main-input.error-shake {
    animation: dgh-shake 0.4s ease-in-out;
  }

  @keyframes dgh-shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-8px); }
    75% { transform: translateX(8px); }
  }

  /* ============ FOOTER ROW ============ */
  .dgh-input-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(226, 232, 240, 0.7);
  }

  .dgh-ext-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .dgh-ext-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--dgh-muted);
    margin-right: 0.25rem;
  }

  .ext-btn {
    padding: 0.5rem 1rem;
    background: rgba(248, 250, 252, 0.9);
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: 9999px;
    font-family: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--dgh-muted);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .ext-btn:hover {
    border-color: rgba(81, 112, 255, 0.4);
    color: var(--dgh-primary);
    transform: translateY(-1px);
  }

  .ext-btn.active {
    background: linear-gradient(135deg, rgba(81, 112, 255, 0.12), rgba(139, 92, 246, 0.12));
    border-color: rgba(81, 112, 255, 0.45);
    color: var(--dgh-primary);
    box-shadow: 0 2px 8px rgba(81, 112, 255, 0.15);
  }

  /* ============ GENERATE BUTTON ============ */
  .dgh-generate-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.875rem 1.75rem;
    background: linear-gradient(135deg, var(--dgh-primary) 0%, var(--dgh-primary-light) 100%);
    color: white;
    border: none;
    border-radius: 14px;
    font-family: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 14px rgba(81, 112, 255, 0.39);
    white-space: nowrap;
  }

  .dgh-generate-btn:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(81, 112, 255, 0.45);
  }

  .dgh-generate-btn:active:not(:disabled) {
    transform: translateY(0);
  }

  .dgh-btn-arrow {
    transition: transform 0.25s ease;
  }

  .dgh-generate-btn:hover:not(:disabled) .dgh-btn-arrow {
    transform: translateX(3px);
  }

  .dgh-btn-spinner {
    display: none;
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255, 255, 255, 0.4);
    border-top-color: white;
    border-radius: 50%;
    animation: dgh-spin 0.8s linear infinite;
  }

  .dgh-btn-loading-text {
    display: none;
  }

  .dgh-generate-btn.loading .dgh-btn-spinner {
    display: inline-block;
  }

  .dgh-generate-btn.loading .dgh-btn-text,
  .dgh-generate-btn.loading .dgh-btn-arrow {
    display: none;
  }

  .dgh-generate-btn.loading .dgh-btn-loading-text {
    display: inline;
  }

  .dgh-generate-btn:disabled {
    opacity: 0.75;
    cursor: not-allowed;
  }

  @keyframes dgh-spin {
    to { transform: rotate(360deg); }
  }

  /* ============ EXAMPLES ============ */
  .dgh-examples {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 1.25rem;
  }

  .dgh-examples-label {
    font-size: 0.8125rem;
    color: var(--dgh-muted);
    font-weight: 500;
  }

  .dgh-example {
    padding: 0.4rem 0.875rem;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: 9999px;
    font-family: inherit;
    font-size: 0.8125rem;
    color: var(--dgh-muted);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .dgh-example:hover {
    border-color: rgba(139, 92, 246, 0.4);
    color: var(--dgh-purple);
    background: rgba(139, 92, 246, 0.06);
    transform: translateY(-1px);
  }

  /* ============ TRUST ROW ============ */
  .dgh-trust-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.125rem;
    flex-wrap: wrap;
    margin-top: 2.25rem;
  }

  .dgh-trust-item {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.875rem;
    color: var(--dgh-muted);
    font-weight: 500;
  }

  .dgh-trust-item svg {
    color: var(--dgh-primary);
    flex-shrink: 0;
  }

  .dgh-trust-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: rgba(2, 37, 69, 0.2);
  }

  /* ============ RESULTS SECTION (NEW DESIGN) ============ */
  .dgh-results-section {
    padding: 4rem 1.5rem 5rem;
    background: linear-gradient(180deg, rgba(248, 250, 252, 0.8) 0%, rgba(255, 255, 255, 0) 100%);
    position: relative;
  }

  .dgh-results-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(81, 112, 255, 0.3), transparent);
  }

  .dgh-results-section[hidden] {
    display: none;
  }

  .dgh-results-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .dgh-results-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .dgh-results-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--dgh-text);
    margin: 0 0 0.75rem;
  }

  .dgh-results-subtitle {
    font-size: 1.0625rem;
    color: var(--dgh-muted);
    max-width: 480px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .dgh-results-list {
    display: grid;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .dgh-result-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 1.75rem;
    background: white;
    border: 2px solid rgba(226, 232, 240, 0.6);
    border-radius: 16px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  .dgh-result-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: linear-gradient(180deg, var(--dgh-primary), var(--dgh-purple));
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .dgh-result-card:hover {
    border-color: rgba(81, 112, 255, 0.4);
    box-shadow: 0 12px 40px rgba(81, 112, 255, 0.12), 0 4px 12px rgba(81, 112, 255, 0.08);
    transform: translateY(-2px);
  }

  .dgh-result-card:hover::before {
    opacity: 1;
  }

  .dgh-domain-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
    min-width: 0;
  }

  .dgh-domain-name {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--dgh-text);
    letter-spacing: -0.01em;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .dgh-domain-name .tld {
    color: var(--dgh-primary);
    font-weight: 600;
  }

  .dgh-domain-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .dgh-domain-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem;
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.12), rgba(16, 185, 129, 0.08));
    color: #047857;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 600;
    border: 1px solid rgba(16, 185, 129, 0.2);
  }

  .dgh-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--dgh-success);
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
    animation: dgh-ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes dgh-ping {
    75%, 100% {
      transform: scale(1.5);
      opacity: 0;
    }
  }

  .dgh-domain-price {
    font-size: 0.9375rem;
    color: var(--dgh-muted);
    font-weight: 500;
  }

  .dgh-domain-price strong {
    color: var(--dgh-text);
    font-weight: 700;
  }

  .dgh-buy-btn {
    display: inline-flex;
