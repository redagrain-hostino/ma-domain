<script>
  // Example chips: fill the input on click
  document.querySelectorAll('.dgh-example').forEach((chip) => {
    chip.addEventListener('click', () => {
      const input = document.getElementById('domain-input') as HTMLInputElement | null;
      if (input) {
        input.value = (chip as HTMLElement).dataset.example || '';
        input.focus();
      }
    });
  });

  // Steps accordion functionality
  document.querySelectorAll('.dgh-step-header').forEach((header) => {
    header.addEventListener('click', () => {
      const stepItem = (header as HTMLElement).closest('.dgh-step-item') as HTMLElement;
      const isExpanded = stepItem.classList.contains('expanded');
      
      // Close all other steps
      document.querySelectorAll('.dgh-step-item').forEach((item) => {
        item.classList.remove('expanded');
        const btn = item.querySelector('.dgh-step-header') as HTMLElement;
        if (btn) {
          btn.setAttribute('aria-expanded', 'false');
        }
      });
      
      // Toggle current step
      if (!isExpanded) {
        stepItem.classList.add('expanded');
        header.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // Domain generation simulation
  const generateBtn = document.getElementById('generate-btn') as HTMLButtonElement | null;
  const resultsSection = document.getElementById('results-section') as HTMLElement | null;
  const resultsList = document.getElementById('results-list') as HTMLElement | null;
  const domainInput = document.getElementById('domain-input') as HTMLInputElement | null;

  if (generateBtn && domainInput && resultsSection && resultsList) {
    generateBtn.addEventListener('click', () => {
      const rawValue = domainInput.value.trim();
      
      if (!rawValue) {
        domainInput.classList.add('error-shake');
        setTimeout(() => domainInput.classList.remove('error-shake'), 400);
        return;
      }

      // Clean the input to make a valid domain slug
      const slug = rawValue.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

      // Show loading state
      generateBtn.classList.add('loading');
      generateBtn.disabled = true;

      // Simulate API call delay (1.2 seconds)
      setTimeout(() => {
        generateBtn.classList.remove('loading');
        generateBtn.disabled = false;
        
        // Generate static variations based on user input
        const extensions = [
          { tld: '.ma', price: '$9.99' },
          { tld: '.com', price: '$11.99' },
          { tld: '.shop', price: '$8.99' },
          { tld: '.net', price: '$12.99' }
        ];
        
        const prefixes = ['', 'get-', 'try-', 'my-'];
        
        const generatedDomains = [
          { 
            name: slug, 
            tld: extensions[0].tld, 
            price: extensions[0].price,
            url: `https://www.hostinger.com/domain-name-search?query=${slug}${extensions[0].tld}`
          },
          { 
            name: slug, 
            tld: extensions[1].tld, 
            price: extensions[1].price,
            url: `https://www.hostinger.com/domain-name-search?query=${slug}${extensions[1].tld}`
          },
          { 
            name: prefixes[1] + slug, 
            tld: extensions[0].tld, 
            price: extensions[0].price,
            url: `https://www.hostinger.com/domain-name-search?query=${prefixes[1]}${slug}${extensions[0].tld}`
          },
          { 
            name: slug + '-store', 
            tld: extensions[2].tld, 
            price: extensions[2].price,
            url: `https://www.hostinger.com/domain-name-search?query=${slug}-store${extensions[2].tld}`
          }
        ];

        // Inject results into DOM with new design
        resultsList.innerHTML = generatedDomains.map((domain, index) => `
          <div class="dgh-result-card" style="animation: dgh-fadeIn 0.4s ease ${index * 0.1}s both;">
            <div class="dgh-domain-info">
              <div class="dgh-domain-name">
                ${domain.name}<span class="tld">${domain.tld}</span>
              </div>
              <div class="dgh-domain-meta">
                <span class="dgh-domain-status">
                  <span class="dgh-status-dot"></span>
                  Available
                </span>
                <span class="dgh-domain-price">
                  <strong>${domain.price}</strong>/year
                </span>
              </div>
            </div>
            <a   href="https://www.hostino.ma/nom-de-domaine-ma" target="_blank" rel="noopener noreferrer" class="dgh-buy-btn">
              <span>Get it now</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        `).join('');
        
        // Show results section and scroll to it
        resultsSection.hidden = false;
        setTimeout(() => {
          resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 100);
      }, 1200);
    });
  }
</script>

<style>
