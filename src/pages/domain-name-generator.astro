---
// src/components/domain-generator/DomainGeneratorHero.astro
interface Props {
  initialExtensions?: string[];
}

const { initialExtensions = ['.ma', '.com', '.shop'] } = Astro.props;

const examples = [
  'casablanca-food',
  'tech-startup',
  'morocco-fashion',
];

const steps = [
  {
    title: 'Find your keywords',
    description: 'Identify the core terms that define your brand and business.'
  },
  {
    title: 'Use the AI generator',
    description: 'Let our AI create unique, brandable domain suggestions based on your keywords.'
  },
  {
    title: 'Select and secure instantly',
    description: 'Choose your favorite domain and register it immediately with real-time availability check.'
  },
  {
    title: 'Launch your idea',
    description: 'Ready for the next step? Easily build a website, purchase hosting, or set up a professional email – all from your Hostinger account.',
    expanded: true
  }
];

import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
<section class="dgh-hero" aria-labelledby="dgh-title">
  <!-- Decorative orbs -->
  <div class="dgh-decor" aria-hidden="true">
    <div class="dgh-orb dgh-orb-1"></div>
    <div class="dgh-orb dgh-orb-2"></div>
    <div class="dgh-orb dgh-orb-3"></div>
  </div>

  <!-- Floating Domain Tags -->
  <div class="dgh-floating-tags" aria-hidden="true">
    <span class="dgh-float-tag" style="top: 8%; left: 4%; animation-delay: 0s;">.ma</span>
    <span class="dgh-float-tag" style="top: 12%; right: 6%; animation-delay: 2.5s;">.co.ma</span>
    <span class="dgh-float-tag" style="bottom: 25%; left: 2%; animation-delay: 4s;">.org.ma</span>
    <span class="dgh-float-tag" style="bottom: 30%; right: 3%; animation-delay: 1.5s;">.edu.ma</span>
    <span class="dgh-float-tag" style="top: 45%; left: 15%; animation-delay: 3s; opacity: 0.5; font-size: 0.8rem;">.net.ma</span>
    <span class="dgh-float-tag" style="top: 55%; right: 18%; animation-delay: 5s; opacity: 0.6; font-size: 0.8rem;">.shop.ma</span>
  </div>

  <!-- Floating elements -->
  <div class="dgh-floating-elements" aria-hidden="true">
    <div class="dgh-float-el dgh-float-ring" style="--x: 8%; --y: 12%; --delay: 0s; --duration: 18s;">
      <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="20" cy="20" r="16"/>
        <circle cx="20" cy="20" r="8" opacity="0.4"/>
      </svg>
    </div>
    <div class="dgh-float-el dgh-float-diamond" style="--x: 92%; --y: 8%; --delay: 2s; --duration: 22s;">
      <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5">
        <polygon points="20,4 36,20 20,36 4,20"/>
        <polygon points="20,4 20,36" opacity="0.3"/>
        <polygon points="4,20 36,20" opacity="0.3"/>
      </svg>
    </div>
    <div class="dgh-float-el dgh-float-sparkle" style="--x: 15%; --y: 72%; --delay: 4s; --duration: 16s;">
      <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M20 2L23.5 14.5L36 18L23.5 21.5L20 34L16.5 21.5L4 18L16.5 14.5L20 2Z"/>
      </svg>
    </div>
    <div class="dgh-float-el dgh-float-globe" style="--x: 85%; --y: 68%; --delay: 1s; --duration: 20s;">
      <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="20" cy="20" r="14"/>
        <ellipse cx="20" cy="20" rx="7" ry="14" opacity="0.4"/>
        <path d="M6 14h28M6 26h28" opacity="0.25"/>
        <circle cx="20" cy="6" r="1.5" fill="currentColor" opacity="0.5"/>
        <circle cx="20" cy="34" r="1.5" fill="currentColor" opacity="0.5"/>
      </svg>
    </div>
    <div class="dgh-float-el dgh-float-hexagon" style="--x: 50%; --y: 4%; --delay: 3s; --duration: 19s;">
      <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5">
        <polygon points="20,3 37,11.5 37,28.5 20,37 3,28.5 3,11.5"/>
        <polygon points="20,3 20,37" opacity="0.2"/>
        <polygon points="3,11.5 37,11.5" opacity="0.2"/>
        <polygon points="3,28.5 37,28.5" opacity="0.2"/>
      </svg>
    </div>
    <div class="dgh-float-el dgh-float-dot-ring" style="--x: 4%; --y: 45%; --delay: 5s; --duration: 15s;">
      <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="20" cy="20" r="10"/>
        <circle cx="20" cy="20" r="3" fill="currentColor" opacity="0.6"/>
      </svg>
    </div>
    <div class="dgh-float-el dgh-float-triangle" style="--x: 94%; --y: 42%; --delay: 2.5s; --duration: 17s;">
      <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5">
        <polygon points="20,3 37,34 3,34"/>
        <polygon points="20,3 20,34" opacity="0.2"/>
        <line x1="3" y1="34" x2="37" y2="34" opacity="0.2"/>
      </svg>
    </div>
    <div class="dgh-float-el dgh-float-cross" style="--x: 30%; --y: 88%; --delay: 3.5s; --duration: 21s;">
      <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M20 4v32M4 20h32"/>
        <circle cx="20" cy="20" r="12" opacity="0.2"/>
      </svg>
    </div>
  </div>

  <!-- Floating particles -->
  <div class="dgh-particles" aria-hidden="true">
    <div class="dgh-particle" style="--x: 10%; --y: 20%; --delay: 0s; --duration: 14s;"></div>
    <div class="dgh-particle" style="--x: 85%; --y: 15%; --delay: 2s; --duration: 18s;"></div>
    <div class="dgh-particle" style="--x: 20%; --y: 75%; --delay: 4s; --duration: 16s;"></div>
    <div class="dgh-particle" style="--x: 70%; --y: 80%; --delay: 1s; --duration: 20s;"></div>
    <div class="dgh-particle" style="--x: 45%; --y: 10%; --delay: 3s; --duration: 12s;"></div>
    <div class="dgh-particle" style="--x: 92%; --y: 55%; --delay: 5s; --duration: 17s;"></div>
    <div class="dgh-particle" style="--x: 5%; --y: 50%; --delay: 6s; --duration: 15s;"></div>
    <div class="dgh-particle" style="--x: 75%; --y: 30%; --delay: 1.5s; --duration: 19s;"></div>
  </div>

  <div class="dgh-container">
    <!-- Badge -->
    <div class="dgh-badge dgh-fade-up">
      <span class="dgh-badge-dot"></span>
      <span>AI-Powered Domain Generator</span>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3L12 3Z"/>
      </svg>
    </div>

    <!-- Title with animated gradient -->
    <h1 class="dgh-title dgh-fade-up" id="dgh-title">
      Find your <span class="dgh-gradient-text dgh-gradient-animated">perfect domain name</span>
    </h1>

    <p class="dgh-subtitle dgh-fade-up">
      Enter your idea or brand name and let AI find the best available extensions for you.
    </p>

    <!-- Large Rectangular Input Card -->
    <div class="dgh-input-card dgh-fade-up dgh-input-glow">
      <div class="dgh-input-inner">
        <div class="dgh-input-row">
          <div class="dgh-sparkle-box dgh-sparkle-pulse" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3L12 3Z"/>
            </svg>
          </div>
          <input
            id="domain-input"
            type="text"
            placeholder="Enter your idea (e.g., casablanca-food)"
            aria-label="Desired domain name"
            class="dgh-main-input"
            autocomplete="off"
          />
          <button class="dgh-clear-btn" id="dgh-clear-btn" type="button" aria-label="Clear input" hidden>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 6L6 18M6 6l12 12"/>
            </svg>
          </button>
          <button id="generate-btn" class="dgh-generate-btn" type="button">
            <span class="dgh-btn-spinner" aria-hidden="true"></span>
            <span class="dgh-btn-text">Generate</span>
            <span class="dgh-btn-loading-text" aria-hidden="true">Generating...</span>
            <svg class="dgh-btn-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Results Section -->
<section id="results-section" class="dgh-results-section" hidden>
  <div class="dgh-results-container">
    <div class="dgh-results-header">
      <h2 class="dgh-results-title dgh-fade-up">
        Available Domain <span class="dgh-gradient-text dgh-gradient-animated">Suggestions</span>
      </h2>
      <p class="dgh-results-subtitle dgh-fade-up">
        We found these perfect matches for your brand. Click to register instantly.
      </p>
    </div>
    
    <div class="dgh-results-list" id="results-list">
      <!-- Results injected by JS -->
    </div>
    
    <div class="dgh-results-footer dgh-fade-up">
      <p class="dgh-results-note">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="16" x2="12" y2="12"/>
          <line x1="12" y1="8" x2="12.01" y2="8"/>
        </svg>
        All domains include free SSL certificate, DNS management, and 24/7 support
      </p>
    </div>
  </div>
</section>

<!-- Steps Section -->
<section class="dgh-steps-section">
  <div class="dgh-steps-container">
    <div class="dgh-steps-badge dgh-fade-up">
      <span>TIPS</span>
    </div>
    
    <h2 class="dgh-steps-title dgh-fade-up">
      Generate the best domain names in <span class="dgh-gradient-text dgh-gradient-animated">4 steps</span>
    </h2>

    <div class="dgh-steps-list">
      {steps.map((step, index) => (
        <div class={`dgh-step-item dgh-fade-up ${step.expanded ? 'expanded' : ''}`} data-step={index} style="transition-delay: ${index * 0.1}s">
          <button 
            class="dgh-step-header" 
            type="button"
            aria-expanded={step.expanded ? 'true' : 'false'}
            aria-controls={`step-content-${index}`}
          >
            <span class="dgh-step-number">{index + 1}.</span>
            <span class="dgh-step-title-text">{step.title}</span>
            <svg 
              class="dgh-step-icon" 
              width="20" 
              height="20" 
              viewBox="0 0 24 24" 
              fill="none" 
              stroke="currentColor" 
              stroke-width="2"
              aria-hidden="true"
            >
              <path d={step.expanded ? "M18 15l-6-6-6 6" : "M6 9l6 6 6-6"} />
            </svg>
          </button>
          
          <div 
            id={`step-content-${index}`}
            class="dgh-step-content"
            role="region"
            aria-labelledby={`step-header-${index}`}
          >
            <p class="dgh-step-description">{step.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Features Section -->
<section class="dgh-features-section">
  <div class="dgh-features-container">
    <div class="dgh-features-header">
      <h2 class="dgh-features-title dgh-fade-up">
        Why choose <span class="dgh-gradient-text dgh-gradient-animated">Hostino</span>
      </h2>
      <p class="dgh-features-subtitle dgh-fade-up">
        Everything you need to launch your online presence
      </p>
    </div>
    <div class="dgh-features-grid">
      <div class="dgh-feature-card dgh-fade-up dgh-feature-card-hover" style="transition-delay: 0.1s">
        <div class="dgh-feature-icon dgh-feature-icon-glow">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <h3 class="dgh-feature-name">Free SSL Certificate</h3>
        <p class="dgh-feature-desc">Secure your website with a free SSL certificate included with every domain.</p>
      </div>
      <div class="dgh-feature-card dgh-fade-up dgh-feature-card-hover" style="transition-delay: 0.2s">
        <div class="dgh-feature-icon dgh-feature-icon-glow">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="3"/>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
          </svg>
        </div>
        <h3 class="dgh-feature-name">Advanced DNS Management</h3>
        <p class="dgh-feature-desc">Full control over your DNS settings with an intuitive management dashboard.</p>
      </div>
      <div class="dgh-feature-card dgh-fade-up dgh-feature-card-hover" style="transition-delay: 0.3s">
        <div class="dgh-feature-icon dgh-feature-icon-glow">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
        </div>
        <h3 class="dgh-feature-name">24/7 Expert Support</h3>
        <p class="dgh-feature-desc">Our team of domain experts is available round-the-clock to assist you.</p>
      </div>
      <div class="dgh-feature-card dgh-fade-up dgh-feature-card-hover" style="transition-delay: 0.4s">
        <div class="dgh-feature-icon dgh-feature-icon-glow">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16v16H4z"/>
            <path d="M9 4v16"/>
            <path d="M15 4v16"/>
            <path d="M4 9h16"/>
            <path d="M4 15h16"/>
          </svg>
        </div>
        <h3 class="dgh-feature-name">1-Click WordPress</h3>
        <p class="dgh-feature-desc">Install WordPress instantly and start building your website in minutes.</p>
      </div>
    </div>
  </div>
</section>

<Footer/>
</Layout>

<style>
  /* ============ HERO ============ */
  .dgh-hero {
    --dgh-primary: #5170ff;
    --dgh-primary-light: #738aff;
    --dgh-purple: #8b5cf6;
    --dgh-pink: #ec4899;
    --dgh-text: #0f172a;
    --dgh-muted: #64748b;
    --dgh-success: #10b981;
    --dgh-warning: #f59e0b;

    position: relative;
    padding: 5rem 1.5rem 4rem;
    overflow: hidden;
    min-height: 100vh;
  }

  .dgh-decor {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .dgh-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.45;
    animation: dgh-float 18s ease-in-out infinite;
  }

  .dgh-orb-1 {
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, hsla(229, 100%, 75%, 0.45) 0%, transparent 70%);
    top: -180px;
    left: -120px;
  }

  .dgh-orb-2 {
    width: 460px;
    height: 460px;
    background: radial-gradient(circle, hsla(280, 100%, 80%, 0.4) 0%, transparent 70%);
    bottom: -160px;
    right: -120px;
    animation-delay: -9s;
  }
  
  .dgh-orb-3 {
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, hsla(340, 100%, 75%, 0.3) 0%, transparent 70%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation-delay: -4s;
    animation-duration: 24s;
  }

  @keyframes dgh-float {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(30px, -25px) scale(1.06); }
  }

  /* ============ FLOATING TAGS ============ */
  .dgh-floating-tags {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .dgh-float-tag {
    position: absolute;
    padding: 0.5rem 1rem;
    background: rgba(255, 255, 255, 0.65);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(81, 112, 255, 0.12);
    border-radius: 9999px;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--dgh-primary);
    box-shadow: 0 4px 20px rgba(81, 112, 255, 0.06);
    animation: float-tag 7s ease-in-out infinite;
    transform-origin: center center;
    letter-spacing: 0.3px;
    user-select: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .dgh-float-tag:hover {
    transform: scale(1.05) !important;
    box-shadow: 0 8px 30px rgba(81, 112, 255, 0.12);
    border-color: rgba(81, 112, 255, 0.25);
    background: rgba(255, 255, 255, 0.85);
  }

  @keyframes float-tag {
    0%, 100% {
      transform: translate(0, 0) scale(1) rotate(0deg);
    }
    33% {
      transform: translate(15px, -18px) scale(1.04) rotate(3deg);
    }
    66% {
      transform: translate(-8px, 12px) scale(0.96) rotate(-2deg);
    }
  }

  .dgh-floating-tags .dgh-float-tag:nth-child(2) { animation-duration: 8s; }
  .dgh-floating-tags .dgh-float-tag:nth-child(3) { animation-duration: 6s; }
  .dgh-floating-tags .dgh-float-tag:nth-child(4) { animation-duration: 9s; }
  .dgh-floating-tags .dgh-float-tag:nth-child(5) { animation-duration: 7.5s; }
  .dgh-floating-tags .dgh-float-tag:nth-child(6) { animation-duration: 6.5s; }

  /* ============ FLOATING ELEMENTS ============ */
  .dgh-floating-elements {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .dgh-float-el {
    position: absolute;
    color: rgba(81, 112, 255, 0.12);
    width: 48px;
    height: 48px;
    animation: dgh-float-el-levitate var(--duration, 18s) ease-in-out infinite;
    animation-delay: var(--delay, 0s);
    left: var(--x, 50%);
    top: var(--y, 50%);
    transform-origin: center center;
  }

  .dgh-float-el svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
    fill: none;
  }

  .dgh-float-ring { color: rgba(81, 112, 255, 0.15); }
  .dgh-float-diamond { color: rgba(139, 92, 246, 0.14); }
  .dgh-float-sparkle { color: rgba(236, 72, 153, 0.12); }
  .dgh-float-globe { color: rgba(16, 185, 129, 0.12); }
  .dgh-float-hexagon { color: rgba(245, 158, 11, 0.10); }
  .dgh-float-dot-ring { color: rgba(81, 112, 255, 0.10); }
  .dgh-float-triangle { color: rgba(139, 92, 246, 0.10); }
  .dgh-float-cross { color: rgba(236, 72, 153, 0.10); }

  @keyframes dgh-float-el-levitate {
    0%, 100% {
      transform: translate(0, 0) scale(1) rotate(0deg);
      opacity: 0.6;
    }
    25% {
      transform: translate(35px, -40px) scale(1.08) rotate(8deg);
      opacity: 0.9;
    }
    50% {
      transform: translate(-25px, -55px) scale(0.92) rotate(-6deg);
      opacity: 0.5;
    }
    75% {
      transform: translate(25px, -20px) scale(1.04) rotate(4deg);
      opacity: 0.8;
    }
  }

  .dgh-float-ring { animation-duration: 18s; }
  .dgh-float-diamond { animation-duration: 22s; }
  .dgh-float-sparkle { animation-duration: 16s; }
  .dgh-float-globe { animation-duration: 20s; }
  .dgh-float-hexagon { animation-duration: 19s; }
  .dgh-float-dot-ring { animation-duration: 15s; }
  .dgh-float-triangle { animation-duration: 17s; }
  .dgh-float-cross { animation-duration: 21s; }

  /* ============ PARTICLES ============ */
  .dgh-particles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .dgh-particle {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(81, 112, 255, 0.2);
    animation: dgh-particle-float var(--duration, 16s) ease-in-out infinite;
    animation-delay: var(--delay, 0s);
    left: var(--x, 50%);
    top: var(--y, 50%);
  }

  .dgh-particle:nth-child(odd) {
    background: rgba(139, 92, 246, 0.15);
    width: 4px;
    height: 4px;
  }

  .dgh-particle:nth-child(3n) {
    width: 8px;
    height: 8px;
    background: rgba(236, 72, 153, 0.1);
  }

  @keyframes dgh-particle-float {
    0%, 100% {
      transform: translate(0, 0) scale(1);
      opacity: 0.3;
    }
    25% {
      transform: translate(40px, -30px) scale(1.2);
      opacity: 0.6;
    }
    50% {
      transform: translate(-20px, -50px) scale(0.8);
      opacity: 0.2;
    }
    75% {
      transform: translate(30px, 20px) scale(1.4);
      opacity: 0.5;
    }
  }

  .dgh-container {
    position: relative;
    z-index: 1;
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  /* ============ BADGE ============ */
  .dgh-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(81, 112, 255, 0.15);
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--dgh-primary);
    margin-bottom: 1.75rem;
  }

  .dgh-badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--dgh-primary);
    box-shadow: 0 0 0 4px rgba(81, 112, 255, 0.15);
    animation: dgh-pulse 2.5s ease-in-out infinite;
  }

  @keyframes dgh-pulse {
    0%, 100% { box-shadow: 0 0 0 4px rgba(81, 112, 255, 0.15); }
    50% { box-shadow: 0 0 0 8px rgba(81, 112, 255, 0); }
  }

  /* ============ TITLE ============ */
  .dgh-title {
    font-size: clamp(2.25rem, 5.5vw, 3.75rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--dgh-text);
    margin: 0 0 1.25rem;
  }

  .dgh-gradient-text {
        background: linear-gradient(135deg, var(--color-primary) 0%, #738aff 50%, #9fb0ff 100%);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .dgh-gradient-animated {
    animation: dgh-gradient-shift 6s ease-in-out infinite;
  }

  @keyframes dgh-gradient-shift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .dgh-subtitle {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--dgh-muted);
    max-width: 560px;
    margin: 0 auto 2rem;
  }

  /* ============ LARGE RECTANGULAR INPUT CARD ============ */
  .dgh-input-card {
    position: relative;
    border-radius: 16px;
    padding: 2px;
    background: linear-gradient(135deg, rgba(81, 112, 255, 0.25), rgba(139, 92, 246, 0.25), rgba(236, 72, 153, 0.2));
    box-shadow: 0 8px 30px rgba(31, 38, 135, 0.06);
    transition: box-shadow 0.4s ease;
    text-align: left;
    max-width: 720px;
    margin: 0 auto;
  }

  .dgh-input-glow {
    animation: dgh-input-glow-pulse 4s ease-in-out infinite;
  }

  @keyframes dgh-input-glow-pulse {
    0%, 100% { box-shadow: 0 8px 30px rgba(31, 38, 135, 0.06); }
    50% { box-shadow: 0 8px 40px rgba(81, 112, 255, 0.14), 0 0 40px rgba(139, 92, 246, 0.04); }
  }

  .dgh-input-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, var(--dgh-primary), var(--dgh-purple), var(--dgh-pink));
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .dgh-input-card:focus-within {
    box-shadow: 0 0 0 5px rgba(81, 112, 255, 0.1), 0 16px 48px rgba(81, 112, 255, 0.16);
    animation: none;
  }

  .dgh-input-card:focus-within::before {
    opacity: 1;
  }

  .dgh-input-inner {
    position: relative;
    z-index: 1;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 15px;
    padding: 0.75rem 0.75rem 0.75rem 1rem;
    display: flex;
    align-items: center;
  }

  .dgh-input-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
  }

  .dgh-sparkle-box {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: linear-gradient(135deg, rgba(81, 112, 255, 0.12), rgba(139, 92, 246, 0.12));
    color: var(--dgh-purple);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .dgh-sparkle-pulse {
    animation: dgh-sparkle-pulse 3s ease-in-out infinite;
  }

  @keyframes dgh-sparkle-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); box-shadow: 0 0 20px rgba(139, 92, 246, 0.15); }
  }

  .dgh-sparkle-box svg {
    width: 20px;
    height: 20px;
  }

  .dgh-main-input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    outline: none;
    font-family: inherit;
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--dgh-text);
    padding: 0.75rem 0;
    height: 100px;
    transition: all 0.3s ease;
  }

  .dgh-main-input::placeholder {
    color: var(--dgh-muted);
    opacity: 0.7;
    font-weight: 400;
    transition: opacity 0.3s ease;
  }

  .dgh-main-input:focus::placeholder {
    opacity: 0.4;
  }

  .dgh-main-input.error-shake {
    animation: dgh-shake 0.4s ease-in-out;
  }

  .dgh-clear-btn {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: none;
    background: rgba(226, 232, 240, 0.6);
    color: var(--dgh-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    animation: dgh-fade-in 0.2s ease;
  }

  .dgh-clear-btn svg {
    width: 16px;
    height: 16px;
  }

  @keyframes dgh-fade-in {
    from { opacity: 0; transform: scale(0.8); }
    to { opacity: 1; transform: scale(1); }
  }

  .dgh-clear-btn:hover {
    background: rgba(226, 232, 240, 0.9);
    color: var(--dgh-text);
    transform: scale(1.05);
  }

  .dgh-clear-btn:active {
    transform: scale(0.92);
  }

  @keyframes dgh-shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-8px); }
    75% { transform: translateX(8px); }
  }

  /* ============ GENERATE BUTTON (ChatGPT/Claude Style) ============ */
  .dgh-generate-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.6rem 1.5rem;
    background: var(--dgh-text);
    color: white;
    border: none;
    border-radius: 9999px;
    font-family: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.15);
    white-space: nowrap;
    flex-shrink: 0;
    height: 48px;
    min-width: 110px;
    position: relative;
    overflow: hidden;
  }

  .dgh-generate-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--dgh-primary), var(--dgh-primary-light));
    opacity: 0;
    transition: opacity 0.4s ease;
    border-radius: inherit;
  }

  .dgh-generate-btn:hover:not(:disabled)::before {
    opacity: 0.15;
  }

  .dgh-generate-btn:hover:not(:disabled) {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.2);
  }

  .dgh-generate-btn:active:not(:disabled) {
    transform: translateY(0) scale(0.97);
  }

  .dgh-btn-arrow {
    transition: transform 0.25s ease;
    position: relative;
    z-index: 1;
    width: 16px;
    height: 16px;
  }

  .dgh-generate-btn:hover:not(:disabled) .dgh-btn-arrow {
    transform: translateX(4px);
  }

  .dgh-btn-text, .dgh-btn-loading-text {
    position: relative;
    z-index: 1;
    font-size: 0.9375rem;
  }

  .dgh-btn-spinner {
    display: none;
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255, 255, 255, 0.4);
    border-top-color: white;
    border-radius: 50%;
    animation: dgh-spin 0.8s linear infinite;
    position: relative;
    z-index: 1;
  }

  .dgh-btn-loading-text {
    display: none;
  }

  .dgh-generate-btn.loading .dgh-btn-spinner {
    display: inline-block;
  }

  .dgh-generate-btn.loading .dgh-btn-text,
  .dgh-generate-btn.loading .dgh-btn-arrow {
    display: none;
  }

  .dgh-generate-btn.loading .dgh-btn-loading-text {
    display: inline;
  }

  .dgh-generate-btn:disabled {
    opacity: 0.75;
    cursor: not-allowed;
  }

  @keyframes dgh-spin {
    to { transform: rotate(360deg); }
  }

  /* ============ RESULTS SECTION ============ */
  .dgh-results-section {
    padding: 4rem 1.5rem 5rem;
    background: linear-gradient(180deg, rgba(248, 250, 252, 0.8) 0%, rgba(255, 255, 255, 0) 100%);
    position: relative;
  }

  .dgh-results-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(81, 112, 255, 0.3), transparent);
  }

  .dgh-results-section[hidden] {
    display: none;
  }

  .dgh-results-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .dgh-results-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .dgh-results-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--dgh-text);
    margin: 0 0 0.75rem;
  }

  .dgh-results-subtitle {
    font-size: 1.0625rem;
    color: var(--dgh-muted);
    max-width: 480px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .dgh-results-list {
    display: grid;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  /* ============ RESULT CARD ============ */
  .dgh-result-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    background: white;
    border: 2px solid rgba(226, 232, 240, 0.6);
    border-radius: 14px;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
    animation: dgh-fadeIn 0.6s ease forwards;
    opacity: 0;
  }

  .dgh-result-card:nth-child(1) { animation-delay: 0.05s; }
  .dgh-result-card:nth-child(2) { animation-delay: 0.15s; }
  .dgh-result-card:nth-child(3) { animation-delay: 0.25s; }
  .dgh-result-card:nth-child(4) { animation-delay: 0.35s; }

  .dgh-result-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: linear-gradient(180deg, var(--dgh-primary), var(--dgh-purple));
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .dgh-result-card::after {
    content: '';
    position: absolute;
    top: -60px;
    right: -60px;
    width: 120px;
    height: 120px;
    background: radial-gradient(circle, rgba(81, 112, 255, 0.04), transparent);
    border-radius: 50%;
    pointer-events: none;
    transition: transform 0.5s ease;
  }

  .dgh-result-card:hover {
    border-color: rgba(81, 112, 255, 0.4);
    box-shadow: 0 12px 40px rgba(81, 112, 255, 0.12), 0 4px 12px rgba(81, 112, 255, 0.08);
    transform: translateY(-3px);
  }

  .dgh-result-card:hover::before {
    opacity: 1;
  }

  .dgh-result-card:hover::after {
    transform: scale(1.8);
  }

  .dgh-domain-info {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
    min-width: 0;
    position: relative;
    z-index: 1;
  }

  .dgh-domain-name {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--dgh-text);
    letter-spacing: -0.01em;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    transition: color 0.3s ease;
  }

  .dgh-result-card:hover .dgh-domain-name {
    color: var(--dgh-primary);
  }

  .dgh-domain-name .tld {
    color: var(--dgh-primary);
    font-weight: 600;
    transition: color 0.3s ease;
  }

  .dgh-result-card:hover .dgh-domain-name .tld {
    color: var(--dgh-purple);
  }

  .dgh-domain-meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .dgh-domain-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.6rem;
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.12), rgba(16, 185, 129, 0.08));
    color: #047857;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    border: 1px solid rgba(16, 185, 129, 0.2);
    transition: all 0.3s ease;
  }

  .dgh-result-card:hover .dgh-domain-status {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.18), rgba(16, 185, 129, 0.12));
    transform: scale(1.02);
  }

  .dgh-status-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--dgh-success);
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
    animation: dgh-ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes dgh-ping {
    75%, 100% {
      transform: scale(1.5);
      opacity: 0;
    }
  }

  .dgh-domain-price {
    font-size: 0.875rem;
    color: var(--dgh-muted);
    font-weight: 500;
  }

  .dgh-domain-price strong {
    color: var(--dgh-text);
    font-weight: 700;
  }

  .dgh-domain-renewal {
    font-size: 0.75rem;
    color: var(--dgh-muted);
    font-weight: 400;
  }

  .dgh-domain-renewal strong {
    color: var(--dgh-text);
    font-weight: 600;
  }

  .dgh-buy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.2rem;
    background: linear-gradient(135deg, #673de6 0%, #5025d1 100%);
    color: white;
    border: none;
    border-radius: 10px;
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 14px rgba(103, 61, 230, 0.3), 0 2px 6px rgba(103, 61, 230, 0.2);
    white-space: nowrap;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
    overflow: hidden;
  }

  .dgh-buy-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #7c52f5, #673de6);
    opacity: 0;
    transition: opacity 0.4s ease;
    border-radius: inherit;
  }

  .dgh-buy-btn:hover::before {
    opacity: 1;
  }

  .dgh-buy-btn span,
  .dgh-buy-btn svg {
    position: relative;
    z-index: 1;
  }

  .dgh-buy-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(103, 61, 230, 0.4), 0 4px 10px rgba(103, 61, 230, 0.25);
  }

  .dgh-buy-btn:active {
    transform: translateY(0) scale(0.97);
  }

  .dgh-buy-btn svg {
    transition: transform 0.25s ease;
    width: 14px;
    height: 14px;
  }

  .dgh-buy-btn:hover svg {
    transform: translateX(3px);
  }

  .dgh-results-footer {
    padding: 1.25rem;
    background: linear-gradient(135deg, rgba(248, 250, 252, 0.8), rgba(255, 255, 255, 0.6));
    border: 1px solid rgba(226, 232, 240, 0.8);
    border-radius: 12px;
    text-align: center;
    transition: all 0.4s ease;
  }

  .dgh-results-footer:hover {
    border-color: rgba(81, 112, 255, 0.15);
    box-shadow: 0 4px 20px rgba(81, 112, 255, 0.06);
  }

  .dgh-results-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--dgh-muted);
    margin: 0;
    transition: color 0.3s ease;
  }

  .dgh-results-footer:hover .dgh-results-note {
    color: var(--dgh-text);
  }

  .dgh-results-note svg {
    color: var(--dgh-primary);
    flex-shrink: 0;
    transition: transform 0.3s ease;
    width: 14px;
    height: 14px;
  }

  .dgh-results-footer:hover .dgh-results-note svg {
    transform: rotate(10deg) scale(1.05);
  }

  /* ============ STEPS SECTION ============ */
  .dgh-steps-section {
    padding: 5rem 1.5rem 4rem;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgba(248, 250, 252, 0.5) 100%);
    position: relative;
  }

  .dgh-steps-container {
    max-width: 820px;
    margin: 0 auto;
  }

  .dgh-steps-badge {
    display: inline-block;
    padding: 0.3rem 0.8rem;
    background: linear-gradient(135deg, rgba(81, 112, 255, 0.1), rgba(139, 92, 246, 0.1));
    border: 1px solid rgba(81, 112, 255, 0.2);
    border-radius: 9999px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--dgh-primary);
    text-transform: uppercase;
    margin-bottom: 1.25rem;
    transition: all 0.3s ease;
  }

  .dgh-steps-badge:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 4px 16px rgba(81, 112, 255, 0.12);
  }

  .dgh-steps-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--dgh-text);
    margin: 0 0 2.5rem;
    text-align: left;
  }

  .dgh-steps-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .dgh-step-item {
    background: white;
    border: 1px solid rgba(226, 232, 240, 0.8);
    border-radius: 14px;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .dgh-step-item:hover {
    border-color: rgba(81, 112, 255, 0.3);
    box-shadow: 0 4px 20px rgba(81, 112, 255, 0.08);
    transform: translateY(-2px);
  }

  .dgh-step-item.expanded {
    border-color: rgba(81, 112, 255, 0.4);
    box-shadow: 0 8px 30px rgba(81, 112, 255, 0.12);
  }

  .dgh-step-header {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    width: 100%;
    padding: 1rem 1.25rem;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 600;
    color: var(--dgh-text);
    transition: all 0.3s ease;
  }

  .dgh-step-header:hover {
    background: rgba(248, 250, 252, 0.6);
  }

  .dgh-step-number {
    font-weight: 700;
    color: var(--dgh-primary);
    font-size: 1rem;
    min-width: 1.8rem;
    transition: all 0.3s ease;
  }

  .dgh-step-item.expanded .dgh-step-number {
    color: var(--dgh-purple);
    transform: scale(1.05);
  }

  .dgh-step-title-text {
    flex: 1;
    transition: color 0.3s ease;
  }

  .dgh-step-item.expanded .dgh-step-title-text {
    color: var(--dgh-primary);
  }

  .dgh-step-icon {
    flex-shrink: 0;
    color: var(--dgh-muted);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), color 0.3s ease;
    width: 18px;
    height: 18px;
  }

  .dgh-step-item.expanded .dgh-step-icon {
    transform: rotate(180deg);
    color: var(--dgh-primary);
  }

  .dgh-step-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1), padding 0.4s ease;
  }

  .dgh-step-item.expanded .dgh-step-content {
    max-height: 200px;
    padding: 0 1.25rem 1.25rem calc(1.25rem + 1.8rem);
  }

  .dgh-step-description {
    margin: 0;
    font-size: 0.875rem;
