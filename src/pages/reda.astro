---
// src/pages/identity-verification.astro
import Layout from '../layouts/Layout.astro';

const steps = [
  { number: '01', title: 'Choose Domain', desc: 'Select the .ma domain you want to register.' },
  { number: '02', title: 'Prepare Documents', desc: 'Gather your valid ID or company registration papers.' },
  { number: '03', title: 'ANRT Review', desc: 'Your information is securely reviewed by the ANRT.' },
  { number: '04', title: 'Activation', desc: 'Once approved, your domain is activated instantly.' }
];

const documents = {
  individuals: [
    { title: 'Moroccan National ID', desc: 'Clear, valid copy of your CIN (Recto/Verso).', icon: 'id' },
    { title: 'Passport', desc: 'Valid passport for non-resident Moroccan citizens.', icon: 'passport' }
  ],
  companies: [
    { title: 'Registre de Commerce', desc: 'Official company registration certificate (RC).', icon: 'building' },
    { title: 'IF & ICE', desc: 'Tax identification and common company identifier.', icon: 'file' }
  ]
};

const docExplanations = {
  cin: 'Used to verify the identity of an individual domain holder.',
  passport: 'May be used as an alternative identity document where applicable.',
  rc: 'Used to validate company registration information.',
  ice: 'Used to identify the registered business entity.'
};

const benefits = [
  { title: 'Security', desc: 'Protect domain ownership and prevent unauthorized takeovers.', icon: 'shield' },
  { title: 'Trust', desc: 'Maintain a reliable and credible .ma domain ecosystem.', icon: 'badge' },
  { title: 'Compliance', desc: 'Follow Moroccan ANRT domain registration regulations.', icon: 'scale' },
  { title: 'Protection', desc: 'Reduce fraudulent, abusive, or cybersquatting registrations.', icon: 'lock' }
];

const faqs = [
  { q: 'Why do I need to verify my identity?', a: 'The ANRT requires identity verification for all .ma domain registrations to ensure accountability, prevent fraud, and maintain the integrity of the Moroccan digital space.' },
  { q: 'What documents are accepted?', a: 'For individuals: A valid Moroccan National ID (CIN) or Passport. For companies: Recent Registre de Commerce (RC), Identifiant Fiscal (IF), and ICE documents.' },
  { q: 'How long does verification take?', a: 'Most verifications are processed within 24 to 48 business hours. Complex corporate structures may take up to 3 business days.' },
  { q: 'Can I register a .ma domain as a company?', a: 'Yes. You will need to provide the company\'s official registration documents and the identity of the legal representative.' }
];

const icons = {
  shield: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  badge: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/><path d="m9 12 2 2 4-4"/></svg>`,
  scale: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/></svg>`,
  lock: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`,
  alert: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>`,
  chevron: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>`
};

const cinMockup = `
  <div class="cin-top">
    <div class="cin-top-fr">
      <span class="cin-fr-1">ROYAUME DU MAROC</span>
      <span class="cin-fr-2">CARTE NATIONALE D'IDENTITÉ</span>
    </div>
    <div class="cin-emblem" aria-hidden="true">
      <svg viewBox="0 0 40 40" width="34" height="34">
        <circle cx="20" cy="20" r="15" fill="none" stroke="#c9a227" stroke-width="1.5"/>
        <circle cx="20" cy="20" r="11" fill="none" stroke="#c9a227" stroke-width="1"/>
        <path d="M20 12l2.3 4.9 5.4.6-4 3.7 1.1 5.3-4.8-2.7-4.8 2.7 1.1-5.3-4-3.7 5.4-.6z" fill="none" stroke="#0e6b4f" stroke-width="1.4"/>
      </svg>
    </div>
    <div class="cin-top-ar" dir="rtl">
      <span>المملكة المغربية</span>
      <span>البطاقة الوطنية للتعريف</span>
    </div>
  </div>
  <div class="cin-body">
    <div class="cin-watermark" aria-hidden="true">
      <svg viewBox="0 0 60 90" width="64" height="96">
        <g fill="none" stroke="#9db8a8" stroke-width="2" opacity="0.45">
          <rect x="22" y="18" width="16" height="60"/>
          <rect x="18" y="78" width="24" height="8"/>
          <path d="M22 18h16M24 26h12M24 34h12M24 42h12M24 50h12M24 58h12M24 66h12"/>
          <rect x="26" y="6" width="8" height="12"/><path d="M30 0v6"/>
        </g>
      </svg>
    </div>
    <div class="cin-left">
      <div class="cin-photo" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="46" height="46"><path d="M12 12c2.7 0 4.5-2 4.5-4.5S14.7 3 12 3 7.5 5 7.5 7.5 9.3 12 12 12zm0 2c-4 0-8 2-8 6v1h16v-1c0-4-4-6-8-6z" fill="#fff"/></svg>
      </div>
      <div class="cin-fields">
        <div class="cin-line"><span class="cin-lbl">Né le</span><span class="cin-val">XX/XX/XXXX</span></div>
        <div class="cin-line"><span class="cin-lbl">Nom & Prénom</span><span class="cin-val">SAMPLE USER</span></div>
        <div class="cin-line"><span class="cin-lbl">Lieu de naissance</span><span class="cin-val">SAMPLE CITY</span></div>
      </div>
      <div class="cin-flag" aria-hidden="true">
        <svg viewBox="0 0 30 20" width="36" height="24"><rect width="30" height="20" rx="2" fill="#c1272d"/><path d="M15 5l1.8 4.2 4.6.4-3.5 3 1 4.5-3.9-2.4-3.9 2.4 1-4.5-3.5-3 4.6-.4z" fill="none" stroke="#0e6b4f" stroke-width="1.2"/></svg>
      </div>
    </div>
    <div class="cin-green" dir="rtl">
      <div class="cin-ar-line"><span>تاريخ الازدياد</span><strong>XX/XX/XXXX</strong></div>
      <div class="cin-ar-line"><span>الاسم الشخصي والعائلي</span><strong>SAMPLE USER</strong></div>
      <div class="cin-ar-line"><span>محل الازدياد</span><strong>SAMPLE CITY</strong></div>
      <div class="cin-photo-sm" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="26" height="26"><path d="M12 12c2.7 0 4.5-2 4.5-4.5S14.7 3 12 3 7.5 5 7.5 7.5 9.3 12 12 12zm0 2c-4 0-8 2-8 6v1h16v-1c0-4-4-6-8-6z" fill="#fff"/></svg>
      </div>
    </div>
  </div>
  <div class="cin-bottom">
    <span class="cin-num">N° <strong>XXXXXXXX</strong> <span dir="rtl">رقم</span></span>
    <span class="cin-valid">Valable jusqu'au : <strong>XX/XX/XXXX</strong></span>
  </div>
`;

const ppMockup = `
  <div class="pp-frame" aria-hidden="true"></div>
  <div class="pp-top">ROYAUME DU MAROC</div>
  <div class="pp-emblem" aria-hidden="true">
    <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="12" cy="12" r="10"/><path d="M12 4l1.8 4 4.2.4-3.2 2.9 1 4.2L12 17l-3.8 2.5 1-4.2-3.2-2.9 4.2-.4z"/></svg>
  </div>
  <div class="pp-word">PASSPORT</div>
  <div class="pp-sub">PASSEPORT</div>
  <div class="pp-data">
    <div class="pp-row"><span>No.</span><strong>XXXXXXX</strong></div>
    <div class="pp-row"><span>NAME</span><strong>SAMPLE USER</strong></div>
    <div class="pp-row"><span>DOB</span><strong>XX/XX/XXXX</strong></div>
  </div>
  <div class="pp-mrz" aria-hidden="true">P&lt;MARSAMPLE&lt;&lt;USER&lt;&lt;&lt;&lt;&lt;&lt;XXXX</div>
`;

const rcMockup = `
  <div class="rc-frame" aria-hidden="true"></div>
  <div class="rc-header">
    <div class="rc-seal" aria-hidden="true">
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5.5"/><path d="M12 3v18M3 12h18"/></svg>
    </div>
    <div class="rc-title">REGISTRE DE COMMERCE</div>
    <div class="rc-sub">TRIBUNAL DE COMMERCE</div>
    <div class="rc-stamp" aria-hidden="true">VERIFIED ✓</div>
  </div>
  <div class="rc-rows">
    <div class="rc-row"><span>Company</span><strong>SAMPLE COMPANY SARL</strong></div>
    <div class="rc-row"><span>RC</span><strong>XXXXXXXX</strong></div>
    <div class="rc-row"><span>ICE</span><strong>XXXXXXXXXXXXXXXX</strong></div>
    <div class="rc-row"><span>Legal Form</span><strong>SARL</strong></div>
    <div class="rc-row"><span>Status</span><strong class="rc-active">ACTIVE</strong></div>
    <div class="rc-row"><span>Registration</span><strong>XX/XX/XXXX</strong></div>
  </div>
`;

const iceMockup = `
  <div class="ice-header">
    <span class="ice-icon" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 8h4M7 12h10M7 16h7"/></svg>
    </span>
    <span class="ice-title">BUSINESS IDENTIFICATION</span>
    <span class="ice-live">● ACTIVE</span>
  </div>
  <div class="ice-barcode" aria-hidden="true">
    <svg width="100%" height="24" viewBox="0 0 200 24" preserveAspectRatio="none">
      <g fill="currentColor"><rect x="0" width="2" height="24"/><rect x="5" width="1" height="24"/><rect x="9" width="3" height="24"/><rect x="15" width="1" height="24"/><rect x="19" width="2" height="24"/><rect x="24" width="1" height="24"/><rect x="28" width="3" height="24"/><rect x="34" width="2" height="24"/><rect x="39" width="1" height="24"/><rect x="43" width="2" height="24"/><rect x="48" width="3" height="24"/><rect x="54" width="1" height="24"/><rect x="58" width="2" height="24"/><rect x="63" width="1" height="24"/><rect x="67" width="3" height="24"/><rect x="73" width="2" height="24"/><rect x="78" width="1" height="24"/><rect x="82" width="2" height="24"/><rect x="87" width="3" height="24"/><rect x="93" width="1" height="24"/><rect x="97" width="2" height="24"/><rect x="102" width="1" height="24"/><rect x="106" width="3" height="24"/><rect x="112" width="2" height="24"/><rect x="117" width="1" height="24"/><rect x="121" width="2" height="24"/><rect x="126" width="3" height="24"/><rect x="132" width="1" height="24"/><rect x="136" width="2" height="24"/><rect x="141" width="1" height="24"/><rect x="145" width="3" height="24"/><rect x="151" width="2" height="24"/><rect x="156" width="1" height="24"/><rect x="160" width="2" height="24"/><rect x="165" width="3" height="24"/><rect x="171" width="1" height="24"/><rect x="175" width="2" height="24"/><rect x="180" width="1" height="24"/><rect x="184" width="3" height="24"/><rect x="190" width="2" height="24"/><rect x="195" width="1" height="24"/></g>
    </svg>
  </div>
  <div class="ice-main">
    <div class="ice-qr" aria-hidden="true">
      <svg width="52" height="52" viewBox="0 0 11 11" shape-rendering="crispEdges">
        <g fill="currentColor"><rect x="0" y="0" width="3" height="3"/><rect x="8" y="0" width="3" height="3"/><rect x="0" y="8" width="3" height="3"/><rect x="4" y="0" width="1" height="1"/><rect x="5" y="2" width="1" height="1"/><rect x="4" y="4" width="1" height="1"/><rect x="6" y="5" width="1" height="1"/><rect x="2" y="5" width="1" height="1"/><rect x="5" y="7" width="1" height="1"/><rect x="8" y="6" width="1" height="1"/><rect x="10" y="8" width="1" height="1"/><rect x="6" y="9" width="1" height="1"/><rect x="4" y="10" width="1" height="1"/></g>
      </svg>
    </div>
    <div class="ice-fields">
      <div class="ice-field"><span>Company Name</span><strong>SAMPLE COMPANY</strong></div>
      <div class="ice-field"><span>ICE</span><strong>XXXXXXXXXXXXXXXX</strong></div>
      <div class="ice-field"><span>RC</span><strong>XXXXXXXX</strong></div>
      <div class="ice-field"><span>Legal Form</span><strong>SARL</strong></div>
    </div>
  </div>
  <div class="ice-footer">
    <span>Status</span>
    <strong class="ice-verified">VERIFIED ✓</strong>
  </div>
`;
---

<Layout title="Identity Verification | .ma Domain Registration">
  <main class="hv-page">

    <!-- ============ HERO (mirrors Hero.astro exactly) ============ -->
    <section class="hv-hero" aria-labelledby="hv-hero-title">
      <div class="hero-decor" aria-hidden="true">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
      </div>

      <div class="container">
        <div class="hero-grid">
          <!-- LEFT -->
          <div class="hero-content">
            <div class="badge fade-in" style="--delay: 0.1s">
              <span class="badge-dot"></span>
              <span>ANRT compliant verification</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>

            <h1 class="hero-title fade-in" id="hv-hero-title" style="--delay: 0.2s">
              Verify your identity
              <span class="gradient-text">for your .ma</span>
              domain
            </h1>

            <p class="hero-subtitle fade-in" style="--delay: 0.3s">
              All .ma domain registrations require a brief, secure identity verification in line with Moroccan ANRT regulations. Prepare your documents and go live with confidence.
            </p>

            <div class="secondary-links fade-in" style="--delay: 0.4s; margin-bottom: 1.5rem;">
              <a href="/register" class="search-submit">
                <span>Start Verification</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
              <a href="/search" class="ghost-link">
                <span>Check Domain Availability</span>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M7 17L17 7M7 7h10v10"/>
                </svg>
              </a>
            </div>

            <div class="trust-row fade-in" style="--delay: 0.5s">
              <div class="trust-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                <span>Secure & Encrypted</span>
              </div>
              <span class="trust-dot" aria-hidden="true"></span>
              <div class="trust-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                <span>Fast Processing</span>
              </div>
              <span class="trust-dot" aria-hidden="true"></span>
              <div class="trust-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                <span>ANRT Approved</span>
              </div>
            </div>
          </div>

          <!-- RIGHT: visual stack (matching Hero.astro) -->
          <div class="hero-visual fade-in" style="--delay: 0.3s" aria-hidden="true">
            <div class="visual-stack">
              <div class="cin-stack">
                <div class="cin-card cin-back" set:html={cinMockup}></div>
                <div class="cin-card cin-front" set:html={cinMockup}></div>
              </div>

              <div class="float-card float-1">
                <span class="mini-dot green"></span>
                <span class="mini-domain">CIN Verified</span>
              </div>
              <div class="float-card float-2">
                <span class="mini-dot green"></span>
                <span class="mini-domain">ANRT Approved</span>
              </div>
              <div class="float-card float-3">
                <span class="mini-dot orange"></span>
                <span class="mini-domain">Reviewing…</span>
              </div>

              <div class="ext-pill ext-1">.ma</div>
              <div class="ext-pill ext-2">.co.ma</div>
              <div class="ext-pill ext-3">.org.ma</div>
              <div class="ext-pill ext-4">.edu.ma</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ PROCESS STEPS ============ -->
    <section class="hv-section">
      <div class="container">
        <div class="section-header fade-in" style="--delay: 0.1s">
          <h2>How verification works</h2>
          <p>A simple, secure, and transparent process to get your domain online.</p>
        </div>

        <div class="hv-steps">
          {steps.map((s, i) => (
            <div class="hv-step fade-in" style={`--delay: ${0.15 + i * 0.08}s`}>
              <div class="step-number">{s.number}</div>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ DOCUMENTS ============ -->
    <section class="hv-section hv-docs-section">
      <div class="container">
        <div class="section-header fade-in" style="--delay: 0.1s">
          <h2>Documents required for <span class="gradient-text">.ma verification</span></h2>
          <p>Depending on your profile, ANRT may require identity or company documentation to validate your .ma domain registration.</p>
          <div class="hv-legend" aria-hidden="true">
            <span class="hv-legend-item"><span class="hv-dot hv-dot-ind"></span> Individuals</span>
            <span class="hv-legend-item"><span class="hv-dot hv-dot-com"></span> Companies</span>
          </div>
        </div>

        <!-- Pipeline -->
        <div class="hv-flow fade-in" style="--delay: 0.15s">
          <div class="hv-flow-step">
            <div class="hv-flow-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            </div>
            <span>Uploaded</span>
          </div>
          <div class="hv-flow-line" aria-hidden="true"></div>
          <div class="hv-flow-step">
            <div class="hv-flow-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </div>
            <span>Identity check</span>
          </div>
          <div class="hv-flow-line" aria-hidden="true"></div>
          <div class="hv-flow-step">
            <div class="hv-flow-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <span>ANRT review</span>
          </div>
          <div class="hv-flow-line" aria-hidden="true"></div>
          <div class="hv-flow-step hv-flow-final">
            <div class="hv-flow-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <span>Verified ✓</span>
          </div>
        </div>

        <!-- Bento -->
        <div class="hv-bento">

          <!-- CIN hero -->
          <article class="hv-doc hv-doc-hero fade-in" style="--delay: 0.2s">
            <div class="hv-doc-top">
              <span class="hv-tag hv-tag-ind">For individuals</span>
              <span class="hv-doc-badge">Primary document</span>
            </div>
            <div class="hv-doc-stage">
              <div class="hv-scanline" aria-hidden="true"></div>
              <div class="cin-card cin-inline" role="img" aria-label="Sample preview of a Moroccan National ID card" set:html={cinMockup}></div>
            </div>
            <div class="hv-status" aria-hidden="true">
              <span class="st-idle">Preview Mode</span>
              <span class="st-verify">VERIFYING DOCUMENT…</span>
              <span class="st-done">DOCUMENT FORMAT ✓</span>
            </div>
            <div class="hv-doc-info">
              <h3>{documents.individuals[0].title} (CIN)</h3>
              <p>{docExplanations.cin}</p>
            </div>
          </article>

          <!-- Passport -->
          <article class="hv-doc hv-doc-tall fade-in" style="--delay: 0.28s">
            <div class="hv-doc-top">
              <span class="hv-tag hv-tag-ind">For individuals</span>
              <span class="hv-doc-badge">Alternative</span>
            </div>
            <div class="hv-doc-stage">
              <div class="hv-scanline" aria-hidden="true"></div>
              <div class="pp-card" role="img" aria-label="Sample preview of a Moroccan passport" set:html={ppMockup}></div>
            </div>
            <div class="hv-status" aria-hidden="true">
              <span class="st-idle">Preview Mode</span>
              <span class="st-verify">VERIFYING DOCUMENT…</span>
              <span class="st-done">DOCUMENT FORMAT ✓</span>
            </div>
            <div class="hv-doc-info">
              <h3>{documents.individuals[1].title}</h3>
              <p>{docExplanations.passport}</p>
            </div>
          </article>

          <!-- RC -->
          <article class="hv-doc fade-in" style="--delay: 0.22s">
            <div class="hv-doc-top">
              <span class="hv-tag hv-tag-com">For companies</span>
              <span class="hv-doc-badge">Required</span>
            </div>
            <div class="hv-doc-stage">
              <div class="hv-scanline" aria-hidden="true"></div>
