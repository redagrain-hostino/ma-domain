---
// Hero.astro
interface Props {
    title?: string;
    subtitle?: string;
}

const {
    title = "Find the perfect domain for your next idea",
    subtitle = "Search, discover, and secure memorable domain names for your business, startup, or personal project in Morocco and worldwide.",
} = Astro.props;
---

<section class="hero section" aria-labelledby="hero-title">
    <!-- Decorative floating elements -->
    <div class="hero-decor" aria-hidden="true">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
    </div>

    <div class="container">
        <div class="hero-grid">

            <!-- LEFT: Content -->
            <div class="hero-content">
                <div class="badge fade-in" style="--delay: 0.1s">
                    <span class="badge-dot"></span>
                    <span>Premium domain marketplace</span>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                </div>

                <h1 class="hero-title fade-in" id="hero-title" style="--delay: 0.2s">
                    {title.split(' ').slice(0, -4).join(' ')}
                    <span class="gradient-text">{title.split(' ').slice(-4, -2).join(' ')}</span>
                    {title.split(' ').slice(-2 ).join(' ')}
                </h1>

                <p class="hero-subtitle fade-in" style="--delay: 0.3s">
                    {subtitle}
                </p>

                <!-- Premium Search Bar -->
                <form class="search-card fade-in" style="--delay: 0.4s" id="hero-search-form" action="https://mawhois.com/" method="GET" target="_blank" role="search" aria-label="Search for a domain">
                    <div class="search-inner">
                        <div class="search-field">
                            <svg class="search-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <circle cx="11" cy="11" r="8"/>
                                <path d="m21 21-4.3-4.3"/>
                            </svg>
                            <input
                                type="text"
                                id="hero-domain-input"
                                class="search-input"
                                placeholder="Search for your ideal domain..."
                                aria-label="Domain name"
                                autocomplete="off"
                                required
                            />
                            <input type="hidden" name="domain" id="hero-domain-full" />
                            <select class="extension-select" id="hero-ext-select">
                                <option value=".ma">.ma</option>
                                <option value=".co.ma">.co.ma</option>
                                <option value=".net.ma">.net.ma</option>
                                <option value=".org.ma">.org.ma</option>
                                <option value=".edu.ma">.edu.ma</option>
                            </select>
                        </div>
                        <button type="submit" class="search-submit">
                            <span>Search</span>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                                <path d="M5 12h14M12 5l7 7-7 7"/>
                            </svg>
                        </button>
                    </div>
                </form>

                <!-- Trust indicators -->
                <div class="trust-row fade-in" style="--delay: 0.5s">
                    <div class="trust-item">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
                        </svg>
                        <span>Instant search</span>
                    </div>
                    <span class="trust-dot" aria-hidden="true"></span>
                    <div class="trust-item">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                            <path d="M20 6L9 17l-5-5"/>
                        </svg>
                        <span>Transparent pricing</span>
                    </div>
                    <span class="trust-dot" aria-hidden="true"></span>
                    <div class="trust-item">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        </svg>
                        <span>Secure registration</span>
                    </div>
                </div>

                <!-- Secondary actions -->
                <div class="secondary-links fade-in" style="--delay: 0.6s">
                    <a href="https://mawhois.com/" target="_blank" rel="noopener" class="ghost-link">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M12 6v6l4 2"/>
                        </svg>
                        <span>WHOIS Lookup</span>
                    </a>
                    <span class="link-sep" aria-hidden="true"></span>
                    <a href="https://hostino.ma/" target="_blank" rel="noopener" class="ghost-link">
                        <span>Transfer a domain</span>
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M7 17L17 7M7 7h10v10"/>
                        </svg>
                    </a>
                </div>
            </div>

            <!-- RIGHT: Visual composition -->
            <div class="hero-visual fade-in" style="--delay: 0.3s" aria-hidden="true">
                <div class="visual-stack">
                    <!-- Main showcase card -->
                    <div class="showcase-card">
                        <div class="showcase-header">
                            <span class="showcase-badge">Premium</span>
                            <span class="showcase-price">4 999 DH</span>
                        </div>
                        <div class="showcase-domain">startup.ma</div>
                        <p class="showcase-desc">Ideal for a tech startup in Morocco.</p>
                        <div class="showcase-footer">
                            <div class="showcase-avatars">
                                <span class="avatar"></span>
                                <span class="avatar"></span>
                                <span class="avatar"></span>
                            </div>
                            <span class="showcase-views">12 views this week</span>
                        </div>
                    </div>

                    <!-- Floating mini cards -->
                    <div class="float-card float-1">
                        <span class="mini-dot green"></span>
                        <span class="mini-domain">cloud.ma</span>
                        <span class="mini-price">150.0 DH</span>
                    </div>

                    <div class="float-card float-2">
                        <span class="mini-dot green"></span>
                        <span class="mini-domain">digital.ma</span>
                        <span class="mini-price">150 DH</span>
                    </div>

                    <div class="float-card float-3">
                        <span class="mini-dot orange"></span>
                        <span class="mini-domain">travel.ma</span>
                        <span class="mini-price">150.0 DH</span>
                    </div>

                    <!-- Extension pills -->
                    <div class="ext-pill ext-1">.ma</div>
                    <div class="ext-pill ext-2">.co.ma</div>
                    <div class="ext-pill ext-3">.org.ma</div>
                    <div class="ext-pill ext-4">.edu.ma</div>
                </div>
            </div>

        </div>
    </div>
</section>

<style>
    /* ============ HERO SECTION ============ */
    .hero {
        position: relative;
        padding: 4rem 0 6rem;
        overflow: hidden;
    }

    .hero-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 4rem;
        align-items: center;
    }

    @media (min-width: 1024px) {
        .hero {
            padding: 6rem 0 7rem;
        }
        .hero-grid {
            grid-template-columns: 1.15fr 0.85fr;
            gap: 5rem;
        }
    }

    /* Decorative orbs - match mesh gradient vibe */
    .hero-decor {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: -1;
    }

    .orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        opacity: 0.5;
    }

    .orb-1 {
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, hsla(229, 100%, 75%, 0.4) 0%, transparent 70%);
        top: -150px;
        left: -100px;
    }

    .orb-2 {
        width: 450px;
        height: 450px;
        background: radial-gradient(circle, hsla(229, 100%, 85%, 0.5) 0%, transparent 70%);
        bottom: -150px;
        right: -100px;
    }

    /* ============ BADGE ============ */
    .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        background: rgba(255, 255, 255, 0.6);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(81, 112, 255, 0.15);
        border-radius: 9999px;
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--color-primary);
        margin-bottom: 1.75rem;
    }

    .badge-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--color-primary);
        box-shadow: 0 0 0 4px rgba(81, 112, 255, 0.15);
        animation: pulse 2.5s ease-in-out infinite;
    }

    @keyframes pulse {
        0%, 100% { box-shadow: 0 0 0 4px rgba(81, 112, 255, 0.15); }
        50% { box-shadow: 0 0 0 8px rgba(81, 112, 255, 0); }
    }

    .badge svg {
        color: var(--color-primary);
        transition: transform 0.25s ease;
    }

    .badge:hover svg {
        transform: translateX(3px);
    }

    /* ============ TITLE ============ */
    .hero-title {
        font-size: clamp(2.25rem, 5.5vw, 3.75rem);
        font-weight: 700;
        line-height: 1.1;
        margin-bottom: 1.5rem;
        color: var(--color-text);
        letter-spacing: -0.03em;
    }

    .gradient-text {
        background: linear-gradient(135deg, var(--color-primary) 0%, #738aff 50%, #9fb0ff 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        position: relative;
        display: inline-block;
    }

    .gradient-text::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(81, 112, 255, 0.12), rgba(115, 138, 255, 0.12));
        z-index: -1;
        border-radius: 12px;
        filter: blur(16px);
    }

    /* ============ SUBTITLE ============ */
    .hero-subtitle {
        font-size: 1.125rem;
        line-height: 1.7;
        color: var(--color-text-muted);
        margin-bottom: 2.5rem;
        max-width: 540px;
        font-weight: 400;
    }

    /* ============ SEARCH CARD (Glassmorphism) ============ */
    .search-card {
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.8);
        border-radius: 9999px;
        padding: 0.5rem;
        box-shadow: 0 12px 40px rgba(31, 38, 135, 0.08);
        margin-bottom: 1.5rem;
        transition: all 0.3s ease;
    }

    .search-card:focus-within {
        box-shadow: 0 16px 48px rgba(81, 112, 255, 0.18), 0 0 0 4px rgba(81, 112, 255, 0.08);
        border-color: rgba(81, 112, 255, 0.3);
    }

    .search-inner {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .search-field {
        display: flex;
        align-items: center;
        flex: 1;
        gap: 0.75rem;
        padding: 0.6rem 0.75rem 0.6rem 1.25rem;
        min-width: 0;
    }

    .search-icon {
        color: var(--color-text-muted);
        flex-shrink: 0;
    }

    .search-input {
        flex: 1;
        min-width: 0;
        background: transparent;
        border: none;
        outline: none;
        color: var(--color-text);
        font-size: 1rem;
        font-family: inherit;
        font-weight: 400;
        padding: 0.25rem 0;
    }

    .search-input::placeholder {
        color: var(--color-text-muted);
        opacity: 0.7;
    }

    .extension-select {
        appearance: none;
        background: rgba(81, 112, 255, 0.08) url('data:image/svg+xml;utf8,<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="%235170ff" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>') no-repeat right 0.75rem center;
        background-size: 14px;
        padding: 0.5rem 2rem 0.5rem 1rem;
        border: 1px solid rgba(81, 112, 255, 0.15);
        border-radius: 9999px;
        cursor: pointer;
        font-family: inherit;
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--color-primary);
        transition: all 0.2s ease;
        flex-shrink: 0;
        outline: none;
    }

    .extension-select:hover {
        background-color: rgba(81, 112, 255, 0.14);
    }

    .search-submit {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.875rem 1.75rem;
        background: linear-gradient(135deg, var(--color-primary) 0%, #738aff 100%);
        color: white;
        border: none;
        border-radius: 9999px;
        font-family: inherit;
        font-size: 0.9375rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 14px rgba(81, 112, 255, 0.39);
        white-space: nowrap;
        flex-shrink: 0;
    }

    .search-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(81, 112, 255, 0.45);
    }

    .search-submit:active {
        transform: translateY(0);
    }

    .search-submit svg {
        transition: transform 0.25s ease;
    }

    .search-submit:hover svg {
        transform: translateX(3px);
    }

    /* ============ TRUST ROW ============ */
    .trust-row {
        display: flex;
        align-items: center;
        gap: 1.125rem;
        flex-wrap: wrap;
        margin-bottom: 1.75rem;
    }

    .trust-item {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        font-size: 0.875rem;
        color: var(--color-text-muted);
        font-weight: 500;
    }

    .trust-item svg {
        color: var(--color-primary);
        flex-shrink: 0;
    }

    .trust-dot {
        width: 3px;
        height: 3px;
        border-radius: 50%;
        background: rgba(2, 37, 69, 0.2);
    }

    /* ============ SECONDARY LINKS ============ */
    .secondary-links {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        flex-wrap: wrap;
    }

    .ghost-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--color-text-muted);
        transition: color 0.2s ease;
        padding: 0.25rem 0;
    }

    .ghost-link:hover {
        color: var(--color-primary);
    }

    .ghost-link svg {
        transition: transform 0.25s ease;
    }

    .ghost-link:hover svg {
        transform: translate(2px, -2px);
    }

    .link-sep {
        width: 1px;
        height: 16px;
        background: rgba(2, 37, 69, 0.12);
    }

    /* ============ VISUAL SIDE ============ */
    .hero-visual {
        position: relative;
        min-height: 520px;
        display: none;
    }

    @media (min-width: 1024px) {
        .hero-visual {
            display: block;
        }
    }

    .visual-stack {
        position: relative;
        width: 100%;
        height: 520px;
    }

    /* Main showcase card */
    .showcase-card {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) rotate(-1.5deg);
        width: 280px;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.8);
        border-radius: var(--border-radius);
        padding: 1.75rem;
        box-shadow: 0 20px 50px rgba(31, 38, 135, 0.12);
        animation: float-main 7s ease-in-out infinite;
    }

    @keyframes float-main {
        0%, 100% { transform: translate(-50%, -50%) rotate(-1.5deg); }
        50% { transform: translate(-50%, calc(-50% - 10px)) rotate(-1.5deg); }
    }

    .showcase-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.25rem;
    }

    .showcase-badge {
        padding: 0.3rem 0.75rem;
        background: linear-gradient(135deg, var(--color-primary), #738aff);
        color: white;
        font-size: 0.6875rem;
        font-weight: 600;
        border-radius: 9999px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .showcase-price {
        font-size: 0.9375rem;
        font-weight: 700;
        color: var(--color-text);
    }

    .showcase-domain {
        font-size: 2rem;
        font-weight: 700;
        color: var(--color-text);
        letter-spacing: -0.025em;
        margin-bottom: 0.5rem;
    }

    .showcase-desc {
        font-size: 0.875rem;
        color: var(--color-text-muted);
        line-height: 1.5;
        margin-bottom: 1.25rem;
    }

    .showcase-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 1rem;
        border-top: 1px solid rgba(2, 37, 69, 0.08);
    }

    .showcase-avatars {
        display: flex;
        gap: -8px;
    }

    .avatar {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--color-primary), #738aff);
        border: 2px solid white;
        margin-left: -8px;
    }

    .avatar:first-child { margin-left: 0; }
    .avatar:nth-child(2) { background: linear-gradient(135deg, #738aff, #9fb0ff); }
    .avatar:nth-child(3) { background: linear-gradient(135deg, #9fb0ff, #c7d2fe); }

    .showcase-views {
        font-size: 0.75rem;
        color: var(--color-text-muted);
    }

    /* Floating mini cards */
    .float-card {
        position: absolute;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1rem;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.8);
        border-radius: 9999px;
        box-shadow: 0 10px 30px rgba(31, 38, 135, 0.1);
        font-size: 0.875rem;
    }

    .mini-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .mini-dot.green {
        background: #10b981;
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15);
    }

    .mini-dot.orange {
        background: #f59e0b;
        box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.15);
    }

    .mini-domain {
        font-weight: 600;
        color: var(--color-text);
    }

    .mini-price {
        font-weight: 700;
        color: var(--color-primary);
        margin-left: auto;
        padding-left: 0.5rem;
    }

    .float-1 {
        top: 8%;
        left: 5%;
        transform: rotate(-2deg);
        animation: float-1 6s ease-in-out infinite;
    }

    .float-2 {
        top: 25%;
        right: 0;
        transform: rotate(1.5deg);
        animation: float-2 7s ease-in-out infinite;
        animation-delay: -2s;
    }

    .float-3 {
        bottom: 12%;
        left: 10%;
        transform: rotate(2deg);
        animation: float-3 8s ease-in-out infinite;
        animation-delay: -4s;
    }

    @keyframes float-1 {
        0%, 100% { transform: translate(0, 0) rotate(-2deg); }
        50% { transform: translate(0, -12px) rotate(-2deg); }
    }

    @keyframes float-2 {
        0%, 100% { transform: translate(0, 0) rotate(1.5deg); }
        50% { transform: translate(0, -10px) rotate(1.5deg); }
    }

    @keyframes float-3 {
        0%, 100% { transform: translate(0, 0) rotate(2deg); }
        50% { transform: translate(0, -14px) rotate(2deg); }
    }

    /* Extension pills */
    .ext-pill {
        position: absolute;
        padding: 0.45rem 0.9rem;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(81, 112, 255, 0.2);
        border-radius: 9999px;
        font-size: 0.8125rem;
        font-weight: 700;
        color: var(--color-primary);
        box-shadow: 0 6px 20px rgba(31, 38, 135, 0.08);
    }

    .ext-1 {
        bottom: 35%;
        right: 5%;
        animation: float-1 5.5s ease-in-out infinite;
        animation-delay: -1s;
    }

    .ext-2 {
        bottom: 20%;
        right: 25%;
        animation: float-2 6s ease-in-out infinite;
        animation-delay: -3s;
    }

    .ext-3 {
        top: 45%;
        left: 0;
        animation: float-3 5s ease-in-out infinite;
        animation-delay: -2.5s;
    }

    .ext-4 {
        top: 15%;
        right: 15%;
        animation: float-1 6.5s ease-in-out infinite;
        animation-delay: -1.5s;
    }

    /* ============ FADE IN ANIMATION ============ */
    .fade-in {
        opacity: 0;
        transform: translateY(20px);
        animation: fadeIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        animation-delay: var(--delay, 0s);
    }

    @keyframes fadeIn {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ============ RESPONSIVE ============ */
    @media (max-width: 768px) {
        .hero {
            padding: 3rem 0 4rem;
            text-align: center;
        }

        .badge {
            margin-left: auto;
            margin-right: auto;
        }

        .hero-subtitle {
            margin-left: auto;
            margin-right: auto;
        }

        .search-card {
            border-radius: 24px;
            padding: 0.75rem;
        }

        .search-inner {
            flex-direction: column;
            gap: 0.75rem;
        }

        .search-field {
            width: 100%;
            padding: 0.4rem 0.5rem 0.4rem 1rem;
        }

        .search-submit {
            width: 100%;
            justify-content: center;
            padding: 0.9rem 1.5rem;
        }

        .trust-row {
            justify-content: center;
        }

        .trust-dot {
            display: none;
        }

        .secondary-links {
            justify-content: center;
        }
    }

    @media (max-width: 480px) {
        .hero-title {
            font-size: 2rem;
        }

        .trust-row {
            gap: 0.75rem 1rem;
        }

        .trust-item {
            font-size: 0.8125rem;
        }
    }

    /* ============ REDUCED MOTION ============ */
    @media (prefers-reduced-motion: reduce) {
        .fade-in,
        .showcase-card,
        .float-card,
        .ext-pill,
        .badge-dot {
            animation: none;
            opacity: 1;
            transform: none;
        }
    }
</style>

<script>
    const form = document.getElementById('hero-search-form') as HTMLFormElement;
    const input = document.getElementById('hero-domain-input') as HTMLInputElement;
    const select = document.getElementById('hero-ext-select') as HTMLSelectElement;
    const hidden = document.getElementById('hero-domain-full') as HTMLInputElement;

    if (form && input && select && hidden) {
        form.addEventListener('submit', (e) => {
            let domain = input.value.trim().toLowerCase();
            if (!domain.includes('.')) {
                domain = domain + select.value;
            }
            hidden.value = domain;
        });
    }
</script>