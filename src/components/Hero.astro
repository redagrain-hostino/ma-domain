---
<section class="hero section">
    <div class="container">
        <div class="hero-content">
            <h1 class="hero-title">Discover the Power of a <span class="highlight">.ma</span> Domain</h1>
            <p class="hero-subtitle">The official digital identity of Morocco. Secure your brand, build trust, and reach the Moroccan market with ease.</p>
            
            <div class="hero-actions">
                <a href="https://hostino.ma/" target="_blank" class="btn btn-primary btn-large">Register Your Domain</a>
                <a href="https://mawhois.com/" target="_blank" class="btn btn-outline btn-large">Check Availability</a>
            </div>
        </div>
    </div>
</section>

<style>
    .hero {
        background-color: var(--color-bg-alt);
        padding: 8rem 0 6rem;
        text-align: center;
        border-bottom: 1px solid var(--color-border);
    }

    .hero-content {
        max-width: 800px;
        margin: 0 auto;
    }

    .hero-title {
        font-size: 4rem;
        font-weight: 800;
        line-height: 1.1;
        margin-bottom: 1.5rem;
        color: var(--color-text);
        letter-spacing: -0.02em;
    }

    .highlight {
        color: var(--color-primary);
    }

    .hero-subtitle {
        font-size: 1.25rem;
        color: var(--color-text-muted);
        margin-bottom: 2.5rem;
        max-width: 650px;
        margin-left: auto;
        margin-right: auto;
    }

    .hero-actions {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-large {
        padding: 1rem 2rem;
        font-size: 1.125rem;
    }

    @media (max-width: 768px) {
        .hero-title {
            font-size: 2.5rem;
        }
        .hero {
            padding: 6rem 0 4rem;
        }
    }
</style>
