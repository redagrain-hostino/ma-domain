<section class="section">
    <div class="container">
        <div class="text-center">
            <h2 class="section-title">Why Choose a .ma<span class="gradient-text">Domain?</span></h2>
            <p class="section-subtitle mx-auto">Stand out in the Moroccan market with the official country code top-level domain.</p>
        </div>

        <div class="grid">
            <div class="card">
                <div class="icon-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                </div>
                <h3>Local Trust</h3>
                <p>A .ma domain shows your business is firmly established in Morocco, instantly building credibility and trust with local customers.</p>
            </div>
            
            <div class="card">
                <div class="icon-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><polyline points="11 8 11 11 14 14"></polyline></svg>
                </div>
                <h3>Better Local SEO</h3>
                <p>Search engines prioritize .ma domains for searches originating within Morocco, helping you rank higher for local queries.</p>
            </div>

            <div class="card">
                <div class="icon-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                </div>
                <h3>Brand Protection</h3>
                <p>Register your trademark and prevent competitors from claiming your brand name in the Moroccan digital landscape.</p>
            </div>
        </div>
    </div>
</section>

<style>/* ============ LAYOUT ============ */
.section {
    padding: 6rem 0;
}

.text-center {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 4rem;
}

.mx-auto {
    margin-left: auto;
    margin-right: auto;
}

/* ============ HEADER ============ */
.section-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 1.25rem;
    color: var(--color-text);
    letter-spacing: -0.03em;
}

.section-title::before {
    content: '✦ POURQUOI .MA';
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-primary);
    letter-spacing: 0.15em;
    padding: 0.5rem 1rem;
    background: rgba(81, 112, 255, 0.08);
    border: 1px solid rgba(81, 112, 255, 0.15);
    border-radius: 9999px;
    margin-bottom: 1.5rem;
}

.section-subtitle {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 0 auto;
    max-width: 600px;
}

/* ============ GRID ============ */
.grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
}

@media (min-width: 1024px) {
    .grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
    }
}

/* ============ CARDS ============ */
.card {
    position: relative;
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: var(--border-radius, 24px);
    padding: 2.25rem 2rem;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
}

.card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-primary), #738aff);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s ease;
}

.card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px -12px rgba(31, 38, 135, 0.12);
    border-color: rgba(81, 112, 255, 0.2);
}

.card:hover::before {
    transform: scaleX(1);
}

/* ============ ICON ============ */
.icon-wrapper {
    width: 56px;
    height: 56px;
    background: linear-gradient(135deg, rgba(81, 112, 255, 0.12), rgba(115, 138, 255, 0.08));
    color: var(--color-primary);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    transition: all 0.3s ease;
}

.card:hover .icon-wrapper {
    background: linear-gradient(135deg, var(--color-primary), #738aff);
    color: white;
    transform: scale(1.05);
    box-shadow: 0 8px 20px -4px rgba(81, 112, 255, 0.4);
}

.icon-wrapper svg {
    width: 26px;
    height: 26px;
}

/* ============ TEXT ============ */
.card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--color-text);
    letter-spacing: -0.01em;
    transition: color 0.2s ease;
}
    .gradient-text {
        background: linear-gradient(135deg, var(--color-primary) 0%, #738aff 50%, #9fb0ff 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        position: relative;
        display: inline-block;
    }

.card:hover h3 {
    color: var(--color-primary);
}

.card p {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
    margin: 0;
}

/* ============ RESPONSIVE ============ */
@media (max-width: 768px) {
    .section {
        padding: 4rem 0;
    }
    
    .text-center {
        margin-bottom: 3rem;
    }
    
    .grid {
        gap: 1.25rem;
    }
    
    .card {
        padding: 2rem 1.5rem;
    }
}
</style>
