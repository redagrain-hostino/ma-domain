---
// Header.astro
import maLogo from '../assets/ma-logo.png';

interface Props {
    transparent?: boolean;
}

const { transparent = false } = Astro.props;

const navItems = [
    { label: 'Home', href: '/' },
    {
        label: 'Services',
        href: '#',
        children: [
            { label: '.ma Registration', href: '#register' },
            { label: 'Domain Transfer', href: '#transfer' },
            { label: 'Premium DNS', href: '#dns' },
            { label: 'SSL Certificates', href: '#ssl' },
        ]
    },
    { label: 'Pricing', href: '#pricing' },
    { label: 'Free', href: '#free', badge: 'New' },
    { label: 'WHOIS', href: 'https://mawhois.com/', external: true },
    { label: 'Blog', href: '/blog' },
];

const languages = [
    { code: 'en', label: 'English', flag: '🇬🇧', path: '/en/' },
    { code: 'fr', label: 'Français', flag: '🇫🇷', path: '/fr/' },
    { code: 'ar', label: 'العربية', flag: '🇲🇦', path: '/ar/' },
    { code: 'nl', label: 'Nederlands', flag: '🇳🇱', path: '/nl/' },
    { code: 'es', label: 'Español', flag: '🇪🇸', path: '/es/' },
    { code: 'it', label: 'Italiano', flag: '🇮🇹', path: '/it/' },
    { code: 'de', label: 'Deutsch', flag: '🇩🇪', path: '/de/' },
    { code: 'zh', label: '中文', flag: '🇨🇳', path: '/zh/' },
];

// Langue courante (détection simple via l'URL)
const currentLang = (() => {
    const path = Astro.url.pathname.split('/')[1];
    return languages.find((l) => l.code === path) || languages.find((l) => l.code === 'en');
})();
---

<header class="header" class:list={[{ 'header--transparent': transparent }]}>
    <div class="container header-container">

        <!-- Logo -->
        <a href="/" class="logo-link" aria-label="Back to home">
            <img src={maLogo.src} alt="" class="logo-img" />
            <div class="logo-text">
                <span class="logo-name">.ma</span>
                <span class="logo-tag">Morocco Registry</span>
            </div>
        </a>

        <!-- Desktop Navigation -->
        <nav class="nav-menu" aria-label="Main navigation">
            {navItems.map((item) => (
                item.children ? (
                    <div class="nav-dropdown">
                        <button class="nav-link nav-link--dropdown" aria-expanded="false">
                            <span>{item.label}</span>
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                                <path d="m6 9 6 6 6-6"/>
                            </svg>
                        </button>
                        <div class="dropdown-panel">
                            <div class="dropdown-grid">
                                {item.children.map((child) => (
                                    <a href={child.href} class="dropdown-item">
                                        <span class="dropdown-item-label">{child.label}</span>
                                    </a>
                                ))}
                            </div>
                        </div>
                    </div>
                ) : (
                    <a
                        href={item.href}
                        class="nav-link"
                        class:list={[{ 'nav-link--badge': item.badge }]}
                        target={item.external ? '_blank' : undefined}
                        rel={item.external ? 'noopener' : undefined}
                    >
                        <span>{item.label}</span>
                        {item.badge && <span class="nav-badge">{item.badge}</span>}
                        {item.external && (
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="external-icon" aria-hidden="true">
                                <path d="M7 17L17 7M7 7h10v10"/>
                            </svg>
                        )}
                    </a>
                )
            ))}
        </nav>

        <!-- Actions -->
        <div class="header-actions">
            
            <!-- Language Selector -->
            <div class="lang-selector" data-lang-selector>
                <button class="lang-trigger" aria-haspopup="listbox" aria-expanded="false">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="2" y1="12" x2="22" y2="12"/>
                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                    </svg>
                    <span class="lang-code">{currentLang.code.toUpperCase()}</span>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                        <path d="m6 9 6 6 6-6"/>
                    </svg>
                </button>
                <div class="lang-panel" role="listbox" aria-label="Choose language">
                    <div class="lang-grid">
                        {languages.map((lang) => (
                            <a
                                href={lang.path}
                                class="lang-item"
                                class:list={[{ 'lang-item--active': lang.code === currentLang.code }]}
                                role="option"
                                aria-selected={lang.code === currentLang.code}
                                data-lang-code={lang.code}
                            >
                                <span class="lang-flag">{lang.flag}</span>
                                <span class="lang-label">{lang.label}</span>
                                {lang.code === currentLang.code && (
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="lang-check" aria-hidden="true">
                                        <path d="M20 6L9 17l-5-5"/>
                                    </svg>
                                )}
                            </a>
                        ))}
                    </div>
                </div>
            </div>

            <a href="/register-ma-domain" class="btn-cta">
                <span>Register .ma</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
            </a>

            <!-- Mobile Menu Toggle -->
            <button class="menu-toggle" aria-label="Open menu" aria-expanded="false">
                <span class="bar bar-1"></span>
                <span class="bar bar-2"></span>
                <span class="bar bar-3"></span>
            </button>
        </div>
    </div>

    <!-- Mobile Menu -->
    <div class="mobile-menu" aria-hidden="true">
        <nav class="mobile-nav">
            {navItems.map((item) => (
                item.children ? (
                    <div class="mobile-group">
                        <div class="mobile-group-title">{item.label}</div>
                        {item.children.map((child) => (
                            <a href={child.href} class="mobile-sublink">
                                <span>{child.label}</span>
                            </a>
                        ))}
                    </div>
                ) : (
                    <a
                        href={item.href}
                        class="mobile-link"
                        target={item.external ? '_blank' : undefined}
                        rel={item.external ? 'noopener' : undefined}
                    >
                        <span>{item.label}</span>
                        {item.badge && <span class="nav-badge">{item.badge}</span>}
                    </a>
                )
            ))}
            <div class="mobile-actions">
                <!-- Mobile Language Selector -->
                <div class="mobile-lang-section">
                    <div class="mobile-group-title">Langue</div>
                    <div class="mobile-lang-grid">
                        {languages.map((lang) => (
                            <a
                                href={lang.path}
                                class="mobile-lang-item"
                                class:list={[{ 'mobile-lang-item--active': lang.code === currentLang.code }]}
                                data-lang-code={lang.code}
                            >
                                <span class="mobile-lang-flag">{lang.flag}</span>
                                <span class="mobile-lang-label">{lang.label}</span>
                                {lang.code === currentLang.code && (
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="lang-check" aria-hidden="true">
                                        <path d="M20 6L9 17l-5-5"/>
                                    </svg>
                                )}
                            </a>
                        ))}
                    </div>
                </div>

                <a href="/register-ma-domain" class="mobile-cta">
                    <span>Register .ma</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                </a>
            </div>
        </nav>
    </div>
</header>

<style>
    /* ============ HEADER BASE ============ */
    .header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(245, 248, 255, 0.72);
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
        border-bottom: 1px solid rgba(81, 112, 255, 0.08);
        transition: all 0.3s ease;
    }

    .header--transparent {
        background: transparent;
        backdrop-filter: none;
        border-bottom-color: transparent;
    }

    .header-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 76px;
        gap: 2rem;
    }

    /* ============ LOGO ============ */
    .logo-link {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
        transition: opacity 0.2s ease;
        flex-shrink: 0;
    }

    .logo-link:hover {
        opacity: 0.8;
    }

    .logo-img {
        height: 42px;
        width: auto;
        display: block;
    }

    .logo-text {
        display: flex;
        flex-direction: column;
        line-height: 1;
        gap: 0.15rem;
    }

    .logo-name {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--color-text);
        letter-spacing: -0.02em;
    }

    .logo-tag {
        font-size: 0.6875rem;
        font-weight: 500;
        color: var(--color-text-muted);
        letter-spacing: 0.02em;
    }

    /* ============ DESKTOP NAV ============ */
    .nav-menu {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        margin-left: auto;
    }

    .nav-link {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.55rem 0.9rem;
        font-size: 0.9375rem;
        font-weight: 500;
        color: var(--color-text);
        text-decoration: none;
        border-radius: 10px;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .nav-link:hover {
        color: var(--color-primary);
        background: rgba(81, 112, 255, 0.06);
    }

    .nav-link::after {
        content: '';
        position: absolute;
        bottom: 2px;
        left: 50%;
        width: 0;
        height: 2px;
        background: var(--color-primary);
        border-radius: 2px;
        transform: translateX(-50%);
        transition: width 0.25s ease;
    }

    .nav-link:hover::after {
        width: calc(100% - 1.8rem);
    }

    .nav-link--badge {
        padding-right: 0.7rem;
    }

    .nav-link--dropdown {
        cursor: pointer;
        border: none;
        background: transparent;
        font-family: inherit;
    }

    .nav-link--dropdown svg {
        transition: transform 0.2s ease;
    }

    .external-icon {
        color: var(--color-text-muted);
        margin-left: 0.15rem;
    }

    .nav-badge {
        padding: 0.15rem 0.5rem;
        background: linear-gradient(135deg, var(--color-primary), #738aff);
        color: white;
        font-size: 0.6875rem;
        font-weight: 600;
        border-radius: 9999px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        line-height: 1.4;
    }

    /* ============ DROPDOWN ============ */
    .nav-dropdown {
        position: relative;
    }

    .nav-dropdown:hover .nav-link--dropdown svg {
        transform: rotate(180deg);
    }

    .dropdown-panel {
        position: absolute;
        top: calc(100% + 0.75rem);
        left: 50%;
        transform: translateX(-50%) translateY(-4px);
        padding: 0.5rem;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(81, 112, 255, 0.1);
        border-radius: 16px;
        box-shadow: 0 20px 40px -12px rgba(31, 38, 135, 0.15);
        opacity: 0;
        visibility: hidden;
        transition: all 0.25s ease;
        min-width: 240px;
    }

    .nav-dropdown:hover .dropdown-panel {
        opacity: 1;
        visibility: visible;
        transform: translateX(-50%) translateY(0);
    }

    .dropdown-grid {
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
    }

    .dropdown-item {
        display: flex;
        align-items: center;
        padding: 0.65rem 0.85rem;
        border-radius: 10px;
        text-decoration: none;
        color: var(--color-text);
        font-size: 0.9375rem;
        font-weight: 500;
        transition: background 0.2s ease;
    }

    .dropdown-item:hover {
        background: rgba(81, 112, 255, 0.08);
        color: var(--color-primary);
    }

    /* ============ LANGUAGE SELECTOR (Desktop) ============ */
    .lang-selector {
        position: relative;
    }

    .lang-trigger {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.55rem 0.85rem;
        background: rgba(255, 255, 255, 0.6);
        border: 1px solid rgba(81, 112, 255, 0.12);
        border-radius: 9999px;
        color: var(--color-text);
        font-family: inherit;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.25s ease;
    }

    .lang-trigger:hover {
        background: rgba(255, 255, 255, 0.9);
        border-color: rgba(81, 112, 255, 0.25);
        box-shadow: 0 4px 12px -4px rgba(81, 112, 255, 0.15);
    }

    .lang-trigger[aria-expanded="true"] {
        background: rgba(81, 112, 255, 0.08);
        border-color: rgba(81, 112, 255, 0.3);
        color: var(--color-primary);
    }

    .lang-trigger svg:last-child {
        transition: transform 0.25s ease;
    }

    .lang-trigger[aria-expanded="true"] svg:last-child {
        transform: rotate(180deg);
    }

    .lang-code {
        font-feature-settings: "tnum";
        letter-spacing: 0.04em;
    }

    .lang-panel {
        position: absolute;
        top: calc(100% + 0.5rem);
        right: 0;
        min-width: 200px;
        padding: 0.5rem;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(24px) saturate(180%);
        -webkit-backdrop-filter: blur(24px) saturate(180%);
        border: 1px solid rgba(81, 112, 255, 0.12);
        border-radius: 16px;
        box-shadow: 0 20px 40px -12px rgba(31, 38, 135, 0.18);
        opacity: 0;
        visibility: hidden;
        transform: translateY(-6px);
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 200;
    }

    .lang-panel.is-open {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    .lang-grid {
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
    }

    .lang-item {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        padding: 0.6rem 0.75rem;
        border-radius: 10px;
        text-decoration: none;
        color: var(--color-text);
        font-size: 0.9375rem;
        font-weight: 500;
        transition: all 0.2s ease;
    }

    .lang-item:hover {
        background: rgba(81, 112, 255, 0.08);
        color: var(--color-primary);
    }

    .lang-item--active {
        background: rgba(81, 112, 255, 0.08);
        color: var(--color-primary);
        font-weight: 600;
    }

    .lang-flag {
        font-size: 1.125rem;
        line-height: 1;
        flex-shrink: 0;
    }

    .lang-label {
        flex: 1;
    }

    .lang-check {
        color: var(--color-primary);
        flex-shrink: 0;
    }

    /* ============ ACTIONS ============ */
    .header-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-shrink: 0;
    }

    .btn-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.7rem 1.4rem;
        background: var(--color-text);
        color: white;
        font-size: 0.9375rem;
        font-weight: 600;
        text-decoration: none;
        border-radius: 9999px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
        white-space: nowrap;
    }

    .btn-cta::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, var(--color-primary), #738aff);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .btn-cta:hover::before {
        opacity: 1;
    }

    .btn-cta:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 20px -8px rgba(81, 112, 255, 0.5);
    }

    .btn-cta span,
    .btn-cta svg {
        position: relative;
        z-index: 1;
    }

    .btn-cta svg {
        transition: transform 0.25s ease;
    }

    .btn-cta:hover svg {
        transform: translateX(2px);
    }

    /* ============ MOBILE TOGGLE ============ */
    .menu-toggle {
        display: none;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        width: 44px;
        height: 44px;
        padding: 0 10px;
        background: transparent;
        border: 1px solid rgba(81, 112, 255, 0.1);
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .menu-toggle:hover {
        background: rgba(81, 112, 255, 0.06);
    }

    .bar {
        display: block;
        height: 2px;
        background: var(--color-text);
        border-radius: 2px;
        transition: all 0.3s ease;
        transform-origin: center;
    }

    .bar-1 { width: 20px; }
    .bar-2 { width: 24px; }
    .bar-3 { width: 16px; }

    .menu-toggle[aria-expanded="true"] .bar-1 {
        transform: translateY(7px) rotate(45deg);
        width: 24px;
    }

    .menu-toggle[aria-expanded="true"] .bar-2 {
        opacity: 0;
    }

    .menu-toggle[aria-expanded="true"] .bar-3 {
        transform: translateY(-7px) rotate(-45deg);
        width: 24px;
    }

    /* ============ MOBILE MENU ============ */
    .mobile-menu {
        display: none;
        position: fixed;
        top: 76px;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(245, 248, 255, 0.98);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        z-index: 99;
        overflow-y: auto;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
    }

    .mobile-menu.is-open {
        opacity: 1;
        visibility: visible;
    }

    .mobile-nav {
        display: flex;
        flex-direction: column;
        padding: 2rem 1.5rem;
        gap: 0.25rem;
    }

    .mobile-link,
    .mobile-sublink {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.25rem;
        font-size: 1.125rem;
        font-weight: 600;
        color: var(--color-text);
        text-decoration: none;
        border-radius: 14px;
        transition: all 0.2s ease;
    }

    .mobile-sublink {
        padding: 0.75rem 1.25rem;
        font-size: 1rem;
        font-weight: 500;
        color: var(--color-text-muted);
    }

    .mobile-link:hover,
    .mobile-sublink:hover {
        background: rgba(81, 112, 255, 0.06);
        color: var(--color-primary);
    }

    .mobile-group {
        margin-top: 0.75rem;
    }

    .mobile-group-title {
        padding: 0.5rem 1.25rem;
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--color-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .mobile-actions {
        margin-top: 2rem;
        padding-top: 2rem;
        border-top: 1px solid rgba(81, 112, 255, 0.1);
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    /* Mobile Language Section */
    .mobile-lang-section {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .mobile-lang-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.5rem;
    }

    .mobile-lang-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1rem;
        background: rgba(255, 255, 255, 0.7);
        border: 1px solid rgba(81, 112, 255, 0.1);
        border-radius: 12px;
        text-decoration: none;
        color: var(--color-text);
        font-size: 0.9375rem;
        font-weight: 500;
        transition: all 0.2s ease;
    }

    .mobile-lang-item:hover {
        background: rgba(255, 255, 255, 0.95);
        border-color: rgba(81, 112, 255, 0.2);
    }

    .mobile-lang-item--active {
        background: rgba(81, 112, 255, 0.08);
        border-color: rgba(81, 112, 255, 0.3);
        color: var(--color-primary);
        font-weight: 600;
    }

    .mobile-lang-flag {
        font-size: 1.125rem;
        line-height: 1;
    }

    .mobile-lang-label {
        flex: 1;
    }

    .mobile-lang-item--active .lang-check {
        color: var(--color-primary);
    }

    .mobile-cta {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 1rem 1.25rem;
        background: linear-gradient(135deg, var(--color-primary), #738aff);
        color: white;
        font-size: 1rem;
        font-weight: 600;
        text-decoration: none;
        border-radius: 14px;
        box-shadow: 0 4px 14px rgba(81, 112, 255, 0.39);
    }

    /* ============ RESPONSIVE ============ */
    @media (max-width: 960px) {
        .nav-menu,
        .btn-cta {
            display: none;
        }

        .menu-toggle {
            display: flex;
        }

        .mobile-menu {
            display: block;
        }

        .header-container {
            height: 72px;
        }
    }

    @media (max-width: 480px) {
        .logo-text {
            display: none;
        }

        .logo-img {
            height: 36px;
        }

        .mobile-lang-grid {
            grid-template-columns: 1fr;
        }
    }

    /* ============ REDUCED MOTION ============ */
    @media (prefers-reduced-motion: reduce) {
        .header,
        .nav-link,
        .btn-cta,
        .menu-toggle,
        .bar,
        .dropdown-panel,
        .lang-trigger,
        .lang-panel {
            transition: none;
        }
    }
</style>

<script>
    // ============ Mobile Menu Toggle ============
    const toggle = document.querySelector('.menu-toggle');
    const mobileMenu = document.querySelector('.mobile-menu');
    const body = document.body;

    if (toggle && mobileMenu) {
        toggle.addEventListener('click', () => {
            const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
            toggle.setAttribute('aria-expanded', String(!isExpanded));
            mobileMenu.classList.toggle('is-open');
            mobileMenu.setAttribute('aria-hidden', String(isExpanded));
            body.style.overflow = isExpanded ? '' : 'hidden';
        });

        // Close menu on link click (except language items which navigate)
        mobileMenu.querySelectorAll('.mobile-link, .mobile-sublink').forEach((link) => {
            link.addEventListener('click', () => {
                toggle.setAttribute('aria-expanded', 'false');
                mobileMenu.classList.remove('is-open');
                mobileMenu.setAttribute('aria-hidden', 'true');
                body.style.overflow = '';
            });
        });
    }

    // ============ Desktop Language Selector ============
    document.querySelectorAll('[data-lang-selector]').forEach((selector) => {
        const trigger = selector.querySelector('.lang-trigger');
        const panel = selector.querySelector('.lang-panel');
        if (!trigger || !panel) return;

        // Toggle dropdown
        trigger.addEventListener('click', (e) => {
            e.stopPropagation();
            const isOpen = panel.classList.contains('is-open');
            // Close all other language panels
            document.querySelectorAll('.lang-panel.is-open').forEach((p) => p.classList.remove('is-open'));
            document.querySelectorAll('.lang-trigger[aria-expanded="true"]').forEach((t) => t.setAttribute('aria-expanded', 'false'));
            
            if (!isOpen) {
                panel.classList.add('is-open');
                trigger.setAttribute('aria-expanded', 'true');
            }
        });

        // Close on outside click
        document.addEventListener('click', (e) => {
            if (!selector.contains(e.target)) {
                panel.classList.remove('is-open');
                trigger.setAttribute('aria-expanded', 'false');
            }
        });

        // Keyboard support
        trigger.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                panel.classList.remove('is-open');
                trigger.setAttribute('aria-expanded', 'false');
                trigger.focus();
            }
        });

        // Save selected language to localStorage
        selector.querySelectorAll('.lang-item').forEach((item) => {
            item.addEventListener('click', () => {
                const code = item.getAttribute('data-lang-code');
                if (code) {
                    try {
                        localStorage.setItem('preferred-lang', code);
                    } catch (e) {}
                }
            });
        });
    });
</script>