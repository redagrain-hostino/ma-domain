---
---
<section class="section">
    <div class="container text-center">
        <h2 class="section-title">Transparent & Affordable .ma Pricing</h2>
        <p class="section-subtitle mx-auto">Competitive yearly pricing for your Moroccan domain extensions with no hidden fees.</p>

        <div class="pricing-card card">
            <div class="pricing-header">
                <h3>.ma Domain Registration</h3>
                <div class="price"><span class="currency">DH</span> 150 <span class="period">/ year</span></div>
            </div>
            
            <ul class="pricing-features">
                <li>✓ Full DNS Management</li>
                <li>✓ Free Domain Privacy Protection</li>
                <li>✓ Auto-renewal option</li>
                <li>✓ 24/7 Trilingual Support</li>
            </ul>
            
            <a href="https://hostino.ma/" target="_blank" class="btn btn-primary w-full">View Full Pricing</a>
        </div>
    </div>
</section>

<style>
    .text-center { text-align: center; }
    .mx-auto { margin-left: auto; margin-right: auto; }
    
    .pricing-card {
        max-width: 450px;
        margin: 0 auto;
        padding: 3rem 2rem;
        border-top: 4px solid var(--color-primary);
    }

    .pricing-header h3 {
        font-size: 1.25rem;
        color: var(--color-text-muted);
        margin-bottom: 1rem;
        font-weight: 500;
    }

    .price {
        font-size: 3.5rem;
        font-weight: 800;
        color: var(--color-text);
        margin-bottom: 2rem;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        gap: 0.25rem;
    }

    .currency {
        font-size: 1.25rem;
        font-weight: 600;
        margin-top: 0.75rem;
    }

    .period {
        font-size: 1rem;
        font-weight: 500;
        color: var(--color-text-muted);
        align-self: flex-end;
        margin-bottom: 0.75rem;
    }

    .pricing-features {
        list-style: none;
        padding: 0;
        margin-bottom: 2.5rem;
        text-align: left;
    }

    .pricing-features li {
        padding: 0.75rem 0;
        border-bottom: 1px solid var(--color-border);
        color: var(--color-text);
    }

    .pricing-features li:last-child {
        border-bottom: none;
    }

    .w-full {
        width: 100%;
        display: block;
    }
</style>
