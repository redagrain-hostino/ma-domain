---
// Footer.astro
const year = new Date().getFullYear();

const services = [
    { label: 'Register a domain', href: 'https://hostino.ma/', external: true },
    { label: 'Transfer a domain', href: 'https://hostino.ma/', external: true },
    { label: 'WHOIS Lookup', href: 'https://mawhois.com/', external: true },
    { label: 'Web Hosting', href: 'https://hostino.ma/', external: true },
    { label: 'SSL Certificates', href: '#' },
    { label: 'Premium DNS', href: '#' },
];

const company = [
    { label: 'About us', href: '#' },
    { label: 'ANRT Regulations', href: '#' },
    { label: 'Terms of Service', href: '#' },
    { label: 'Privacy Policy', href: '#' },
    { label: 'Careers', href: '#' },
    { label: 'Blog', href: '#' },
];

const support = [
    { label: 'Help Center', href: '#' },
    { label: 'FAQ', href: '#' },
    { label: 'Open a ticket', href: '#' },
    { label: 'System Status', href: '#' },
    { label: 'Documentation', href: '#' },
];

const socials = [
    { name: 'Twitter', href: '#', icon: 'twitter' },
    { name: 'LinkedIn', href: '#', icon: 'linkedin' },
    { name: 'Facebook', href: '#', icon: 'facebook' },
    { name: 'Instagram', href: '#', icon: 'instagram' },
];

const icons = {
    twitter: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
    linkedin: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
    facebook: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`,
    instagram: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zM5.838 12a6.162 6.162 0 1112.324 0 6.162 6.162 0 01-12.324 0zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>`
};
---

<footer class="footer">
    <!-- Decorative background -->
    <div class="footer-bg" aria-hidden="true">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
    </div>

    <div class="container">

        <!-- Pre-footer: Newsletter -->
        <div class="pre-footer">
            <div class="newsletter-content">
                <div class="newsletter-text">
                    <h3>Stay Informed</h3>
                    <p>Receive the latest news about .ma domains and digital trends in Morocco.</p>
                </div>
                <form class="newsletter-form" aria-label="Inscription newsletter">
                    <div class="form-field">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                            <polyline points="22,6 12,13 2,6"/>
                        </svg>
                        <input 
                            type="email" 
                            placeholder="your@email.com" 
                            aria-label="Adresse email"
                            required
                        >
                    </div>
                    <button type="submit" class="newsletter-btn">
                        <span>Subscribe</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                            <path d="M5 12h14M12 5l7 7-7 7"/>
                        </svg>
                    </button>
                </form>
            </div>
        </div>

        <!-- Main Footer Grid -->
        <div class="footer-grid">
            
            <!-- Brand Column -->
            <div class="footer-brand">
                <a href="/" class="footer-logo">
                    <div class="logo-mark">
                        <span>.ma</span>
                    </div>
                    <div class="logo-text">
                        <span class="logo-name">Morocco Registry</span>
                        <span class="logo-tag">Domain Services</span>
                    </div>
                </a>
                <p class="brand-desc">
                    Your trusted partner for registering and managing accredited domain names in Morocco.
                </p>

                <!-- Social Links -->
                <div class="social-links">
                    {socials.map((social) => (
                        <a 
                            href={social.href} 
                            class="social-link" 
                            aria-label={social.name}
                            target="_blank"
                            rel="noopener"
                        >
                            <Fragment set:html={icons[social.icon]} />
                        </a>
                    ))}
                </div>

                <!-- Language Selector -->
                <div class="language-selector">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="2" y1="12" x2="22" y2="12"/>
                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                    </svg>
                    <span>English (EN)</span>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="m6 9 6 6 6-6"/>
                    </svg>
                </div>
            </div>

            <!-- Services Column -->
            <div class="footer-column">
                <h4 class="column-title">Services</h4>
                <ul class="footer-links">
                    {services.map((link) => (
                        <li>
                            <a 
                                href={link.href} 
                                target={link.external ? '_blank' : undefined}
                                rel={link.external ? 'noopener' : undefined}
                                class="footer-link"
                            >
                                <span>{link.label}</span>
                                {link.external && (
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="external-icon" aria-hidden="true">
                                        <path d="M7 17L17 7M7 7h10v10"/>
                                    </svg>
                                )}
                            </a>
                        </li>
                    ))}
                </ul>
            </div>

            <!-- Company Column -->
            <div class="footer-column">
                <h4 class="column-title">Company</h4>
                <ul class="footer-links">
                    {company.map((link) => (
                        <li>
                            <a href={link.href} class="footer-link">
                                <span>{link.label}</span>
                            </a>
                        </li>
                    ))}
                </ul>
            </div>

            <!-- Support Column -->
            <div class="footer-column">
                <h4 class="column-title">Support</h4>
                <ul class="footer-links">
                    {support.map((link) => (
                        <li>
                            <a href={link.href} class="footer-link">
                                <span>{link.label}</span>
                            </a>
                        </li>
                    ))}
                </ul>

                <!-- Status indicator -->
                <div class="status-indicator">
                    <span class="status-dot"></span>
                    <span>All systems operational</span>
                </div>
            </div>
        </div>

        <!-- Trust Badges -->
        <div class="trust-badges">
            <div class="badge-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
                <span>ANRT Accredited</span>
            </div>
            <div class="badge-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                <span>Secure SSL Payment</span>
            </div>
            <div class="badge-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
                    <path d="M2 12h20"/>
                </svg>
                <span>ICANN Accredited</span>
            </div>
            <div class="badge-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
                <span>Support 24/7</span>
            </div>
        </div>

        <!-- Footer Bottom -->
        <div class="footer-bottom">
            <div class="bottom-left">
                <p class="copyright">
                    © {year} Moroccan Domain Registration Services. 
                </p>
            </div>
            <div class="bottom-right">
                <a href="#" class="bottom-link">Terms</a>
                <span class="separator">·</span>
                <a href="#" class="bottom-link">Privacy</a>
                <span class="separator">·</span>
                <a href="#" class="bottom-link">Cookies</a>
            </div>
        </div>

    </div>
</footer>

<style>
    /* ============ FOOTER BASE ============ */
    .footer {
        position: relative;
        background-color: var(--color-bg-alt);
        padding: 5rem 0 2rem;
        border-top: 1px solid rgba(81, 112, 255, 0.1);
        overflow: hidden;
    }

    /* Decorative orbs */
    .footer-bg {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 0;
    }

    .orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(100px);
        opacity: 0.25;
    }

    .orb-1 {
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(81, 112, 255, 0.4) 0%, transparent 70%);
        top: -100px;
        left: -100px;
    }

    .orb-2 {
        width: 350px;
        height: 350px;
        background: radial-gradient(circle, rgba(115, 138, 255, 0.3) 0%, transparent 70%);
        bottom: -100px;
        right: -100px;
    }

    .container {
        position: relative;
        z-index: 1;
    }

    /* ============ PRE-FOOTER (NEWSLETTER) ============ */
    .pre-footer {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.8);
        border-radius: var(--border-radius);
        padding: 2.5rem;
        margin-bottom: 4rem;
        box-shadow: 0 8px 32px rgba(31, 38, 135, 0.06);
    }

    .newsletter-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 3rem;
    }

    .newsletter-text h3 {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        color: var(--color-text);
        letter-spacing: -0.02em;
    }

    .newsletter-text p {
        color: var(--color-text-muted);
        margin: 0;
        max-width: 400px;
    }

    .newsletter-form {
        display: flex;
        gap: 0.5rem;
        flex-shrink: 0;
        padding: 0.4rem;
        background: rgba(255, 255, 255, 0.8);
        border: 1px solid rgba(81, 112, 255, 0.15);
        border-radius: 9999px;
        transition: all 0.3s ease;
    }

    .newsletter-form:focus-within {
        border-color: rgba(81, 112, 255, 0.35);
        box-shadow: 0 0 0 4px rgba(81, 112, 255, 0.08);
    }

    .form-field {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0 0.75rem 0 1rem;
    }

    .form-field svg {
        color: var(--color-text-muted);
        flex-shrink: 0;
    }

    .form-field input {
        background: transparent;
        border: none;
        outline: none;
        font-family: inherit;
        font-size: 0.9375rem;
        color: var(--color-text);
        min-width: 240px;
        padding: 0.5rem 0;
    }

    .form-field input::placeholder {
        color: var(--color-text-muted);
    }

    .newsletter-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.65rem 1.25rem;
        background: linear-gradient(135deg, var(--color-primary), #738aff);
        color: white;
        border: none;
        border-radius: 9999px;
        font-family: inherit;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        white-space: nowrap;
    }

    .newsletter-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(81, 112, 255, 0.4);
    }

    .newsletter-btn svg {
        transition: transform 0.25s ease;
    }

    .newsletter-btn:hover svg {
        transform: translateX(2px);
    }

    /* ============ FOOTER GRID ============ */
    .footer-grid {
        display: grid;
        grid-template-columns: 1.8fr 1fr 1fr 1fr;
        gap: 3rem;
        margin-bottom: 3rem;
    }

    /* ============ BRAND COLUMN ============ */
    .footer-brand {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .footer-logo {
        display: inline-flex;
        align-items: center;
        gap: 0.875rem;
        text-decoration: none;
        transition: opacity 0.2s ease;
    }

    .footer-logo:hover {
        opacity: 0.85;
    }

    .logo-mark {
        width: 44px;
        height: 44px;
        background: linear-gradient(135deg, var(--color-primary), #738aff);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 800;
        font-size: 1.125rem;
        letter-spacing: -0.02em;
        box-shadow: 0 4px 12px rgba(81, 112, 255, 0.35);
        flex-shrink: 0;
    }

    .logo-text {
        display: flex;
        flex-direction: column;
        line-height: 1.15;
    }

    .logo-name {
        font-size: 1rem;
        font-weight: 700;
        color: var(--color-text);
        letter-spacing: -0.01em;
    }

    .logo-tag {
        font-size: 0.75rem;
        color: var(--color-text-muted);
        font-weight: 500;
    }

    .brand-desc {
        color: var(--color-text-muted);
        font-size: 0.9375rem;
        line-height: 1.7;
        max-width: 320px;
        margin: 0;
    }

    /* Social links */
    .social-links {
        display: flex;
        gap: 0.625rem;
        margin-top: 0.5rem;
    }

    .social-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        background: rgba(255, 255, 255, 0.6);
        border: 1px solid rgba(81, 112, 255, 0.1);
        border-radius: 10px;
        color: var(--color-text-muted);
        transition: all 0.3s ease;
    }

    .social-link:hover {
        background: linear-gradient(135deg, var(--color-primary), #738aff);
        border-color: transparent;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 6px 12px rgba(81, 112, 255, 0.3);
    }

    /* Language selector */
    .language-selector {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.875rem;
        background: rgba(255, 255, 255, 0.6);
        border: 1px solid rgba(81, 112, 255, 0.1);
        border-radius: 9999px;
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--color-text-muted);
        cursor: pointer;
        transition: all 0.2s ease;
        align-self: flex-start;
    }

    .language-selector:hover {
        background: rgba(255, 255, 255, 0.9);
        color: var(--color-text);
        border-color: rgba(81, 112, 255, 0.2);
    }

    /* ============ FOOTER COLUMNS ============ */
    .footer-column {
        display: flex;
        flex-direction: column;
    }

    .column-title {
        font-size: 0.8125rem;
        font-weight: 700;
        color: var(--color-text);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 1.5rem;
    }

    .footer-links {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.875rem;
    }

    .footer-link {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        color: var(--color-text-muted);
        text-decoration: none;
        font-size: 0.9375rem;
        font-weight: 500;
        position: relative;
        transition: color 0.2s ease;
        width: fit-content;
    }

    .footer-link::after {
        content: '';
        position: absolute;
        bottom: -2px;
        left: 0;
        width: 0;
        height: 1px;
        background: var(--color-primary);
        transition: width 0.25s ease;
    }

    .footer-link:hover {
        color: var(--color-primary);
    }

    .footer-link:hover::after {
        width: 100%;
    }

    .external-icon {
        opacity: 0.6;
        transition: transform 0.2s ease;
    }

    .footer-link:hover .external-icon {
        opacity: 1;
        transform: translate(1px, -1px);
    }

    /* Status indicator */
    .status-indicator {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 1.5rem;
        padding: 0.5rem 0.875rem;
        background: rgba(16, 185, 129, 0.08);
        border: 1px solid rgba(16, 185, 129, 0.15);
        border-radius: 9999px;
        font-size: 0.8125rem;
        font-weight: 500;
        color: #059669;
        align-self: flex-start;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #10b981;
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
        animation: pulse 2s ease-in-out infinite;
    }

    @keyframes pulse {
        0%, 100% { box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2); }
        50% { box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
    }

    /* ============ TRUST BADGES ============ */
    .trust-badges {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 2rem;
        flex-wrap: wrap;
        padding: 2rem 0;
        margin-bottom: 2rem;
        border-top: 1px solid rgba(81, 112, 255, 0.08);
        border-bottom: 1px solid rgba(81, 112, 255, 0.08);
    }

    .badge-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--color-text-muted);
    }

    .badge-item svg {
        color: var(--color-primary);
        flex-shrink: 0;
    }

    /* ============ FOOTER BOTTOM ============ */
    .footer-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 2rem;
        flex-wrap: wrap;
    }

    .copyright {
        font-size: 0.875rem;
        color: var(--color-text-muted);
        margin: 0;
    }

    .separator {
        color: rgba(81, 112, 255, 0.2);
        margin: 0 0.5rem;
    }

    .made-in {
        color: var(--color-text-muted);
    }

    .bottom-right {
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }

    .bottom-link {
        font-size: 0.875rem;
        color: var(--color-text-muted);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .bottom-link:hover {
        color: var(--color-primary);
    }

    /* ============ RESPONSIVE ============ */
    @media (max-width: 1024px) {
        .footer-grid {
            grid-template-columns: 1fr 1fr;
            gap: 2.5rem;
        }

        .footer-brand {
            grid-column: 1 / -1;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid rgba(81, 112, 255, 0.08);
        }
    }

    @media (max-width: 768px) {
        .footer {
            padding: 4rem 0 2rem;
        }

        .pre-footer {
            padding: 2rem 1.5rem;
            margin-bottom: 3rem;
        }

        .newsletter-content {
            flex-direction: column;
            align-items: stretch;
            text-align: center;
            gap: 1.5rem;
        }

        .newsletter-text p {
            max-width: none;
        }

        .newsletter-form {
            flex-direction: column;
            background: transparent;
            border: none;
            padding: 0;
            gap: 0.75rem;
        }

