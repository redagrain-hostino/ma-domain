<section class="section bg-primary-light">
    <div class="container">
        <div class="banner-content">
            <div class="banner-text">
                <h2>Get Your .ma Domain for Free!</h2>
                <p>Launch your website today. Register a select web hosting plan with Hostino and receive your .ma domain completely free for the first year.</p>
            </div>
            <div class="banner-action">
                <a href="https://hostino.ma/" target="_blank" class="btn btn-primary">Claim Free Domain & Hosting</a>
            </div>
        </div>
    </div>
</section>

<style>
    .bg-primary-light {
        background-color: #f0f4ff; /* Light shade of primary */
        padding: 4rem 0;
    }

    .banner-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 2rem;
        background: white;
        padding: 3rem;
        border-radius: var(--border-radius);
        border: 1px solid var(--color-border);
        box-shadow: 0 10px 15px -3px rgba(81, 112, 255, 0.1);
    }

    .banner-text h2 {
        font-size: 2rem;
        font-weight: 700;
        color: var(--color-text);
        margin-bottom: 0.75rem;
    }

    .banner-text p {
        color: var(--color-text-muted);
        font-size: 1.125rem;
        max-width: 600px;
        margin: 0;
    }

    .banner-action {
        flex-shrink: 0;
    }

    @media (max-width: 768px) {
        .banner-content {
            flex-direction: column;
            text-align: center;
            padding: 2rem;
        }
    }
</style>
