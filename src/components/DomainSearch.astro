---
---
<section class="search-section section">
    <div class="container">
        <div class="search-card card">
            <h2 class="search-title">Instantly check if your desired .ma domain is available.</h2>
            <form id="domain-search-form" action="https://mawhois.com/" method="GET" target="_blank" class="search-form">
                <div class="input-group">
                    <span class="www">www.</span>
                    <input type="text" id="domain-search-input" class="search-input" placeholder="yourcompany" required />
                    <input type="hidden" name="domain" id="domain-search-full" />
                    <select class="extension-select-inline" id="domain-ext-select">
                        <option value=".ma">.ma</option>
                        <option value=".co.ma">.co.ma</option>
                        <option value=".net.ma">.net.ma</option>
                        <option value=".org.ma">.org.ma</option>
                        <option value=".edu.ma">.edu.ma</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary search-btn">Search</button>
            </form>
        </div>
    </div>
</section>

<style>
    .search-section {
        margin-top: -4rem;
        padding-top: 0;
        position: relative;
        z-index: 10;
    }

    .search-card {
        padding: 3rem;
        text-align: center;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }

    .search-title {
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 2rem;
    }

    .search-form {
        display: flex;
        max-width: 700px;
        margin: 0 auto;
        gap: 1rem;
    }

    .input-group {
        flex: 1;
        display: flex;
        align-items: center;
        border: 2px solid var(--color-border);
        border-radius: 9999px; /* Pill shape for input */
        padding: 0 1.5rem; /* Slightly more padding for pill shape */
        background: white;
        transition: border-color 0.2s ease;
    }

    .input-group:focus-within {
        border-color: var(--color-primary);
        box-shadow: 0 0 0 3px rgba(81, 112, 255, 0.1);
    }

    .www {
        color: var(--color-text-muted);
        font-weight: 500;
        font-size: 1.125rem;
    }

    .extension-select-inline {
        appearance: none;
        background: transparent url('data:image/svg+xml;utf8,<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="%234a5568" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>') no-repeat right center;
        background-size: 14px;
        padding: 0 1.25rem 0 0.25rem;
        border: none;
        outline: none;
        color: var(--color-text-muted);
        font-weight: 500;
        font-size: 1.125rem;
        cursor: pointer;
        font-family: inherit;
    }

    .search-input {
        flex: 1;
        border: none;
        outline: none;
        padding: 1rem 0.5rem;
        font-size: 1.125rem;
        font-weight: 500;
        color: var(--color-text);
        width: 100%;
    }

    .search-btn {
        padding: 0 2.5rem;
        font-size: 1.125rem;
    }

    @media (max-width: 768px) {
        .search-form {
            flex-direction: column;
        }
        .search-btn {
            padding: 1rem;
            width: 100%;
        }
    }
</style>

<script>
    const formInline = document.getElementById('domain-search-form') as HTMLFormElement;
    const inputInline = document.getElementById('domain-search-input') as HTMLInputElement;
    const selectInline = document.getElementById('domain-ext-select') as HTMLSelectElement;
    const hiddenInline = document.getElementById('domain-search-full') as HTMLInputElement;

    if (formInline && inputInline && selectInline && hiddenInline) {
        formInline.addEventListener('submit', (e) => {
            let domain = inputInline.value.trim().toLowerCase();
            if (!domain.includes('.')) {
                domain = domain + selectInline.value;
            }
            hiddenInline.value = domain;
        });
    }
</script>
