<section class="section cta-section">
    <div class="container">
        <div class="cta-box text-center">
            <div class="cta-background">
                <div class="cta-orb cta-orb-1"></div>
                <div class="cta-orb cta-orb-2"></div>
            </div>
            <div class="cta-content">
                <h2 class="cta-title">Ready to Register Your .ma Domain?</h2>
                <p class="cta-subtitle">Secure your Moroccan digital identity today. Join thousands of businesses and individuals who trust our ANRT-accredited platform for instant setup and premium support.</p>
                <div class="cta-actions">
                    <a href="/register-ma-domain" class="btn btn-primary btn-large btn-shadow">
                        Start Your Registration
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-left: 8px;">
                            <path d="M5 12h14M12 5l7 7-7 7"/>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .cta-section {
        padding: 4rem 0 6rem;
    }

    .cta-box {
        background: linear-gradient(135deg, var(--color-bg), var(--color-bg-alt));
        border: 1px solid rgba(81, 112, 255, 0.15);
        border-radius: 32px;
        padding: 6rem 2rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 20px 40px -10px rgba(81, 112, 255, 0.1);
    }
    
    .cta-background {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        overflow: hidden;
    }

    .cta-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        opacity: 0.5;
    }

    .cta-orb-1 {
        width: 300px;
        height: 300px;
        background: var(--color-primary);
        top: -150px;
        left: -100px;
    }

    .cta-orb-2 {
        width: 400px;
        height: 400px;
        background: rgba(81, 112, 255, 0.4);
        bottom: -200px;
        right: -150px;
    }

    .cta-content {
        position: relative;
        z-index: 1;
        max-width: 800px;
        margin: 0 auto;
    }

    .cta-title {
        font-size: clamp(2.5rem, 5vw, 4rem);
        font-weight: 800;
        margin-bottom: 1.5rem;
        color: var(--color-text);
        line-height: 1.2;
        letter-spacing: -0.03em;
    }

    .cta-subtitle {
        font-size: 1.25rem;
        color: var(--color-text-muted);
        margin: 0 auto 3rem auto;
        line-height: 1.6;
    }

    .cta-actions {
        display: flex;
        justify-content: center;
    }

    .btn-large {
        padding: 1.25rem 3rem;
        font-size: 1.125rem;
        border-radius: 9999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .btn-shadow {
        box-shadow: 0 10px 15px -3px rgba(81, 112, 255, 0.3), 0 4px 6px -2px rgba(81, 112, 255, 0.15);
        transition: all 0.3s ease;
    }
    
    .btn-shadow:hover {
        box-shadow: 0 15px 25px -3px rgba(81, 112, 255, 0.4), 0 4px 6px -2px rgba(81, 112, 255, 0.2);
        transform: translateY(-2px);
    }

    .text-center {
        text-align: center;
    }
    
    @media (max-width: 768px) {
        .cta-box {
            padding: 4rem 1.5rem;
            border-radius: 24px;
        }
    }
</style>
