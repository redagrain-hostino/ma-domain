<section class="section cta-section">
    <div class="container">
        <div class="cta-box text-center">
            <h2 class="cta-title">Ready to Register Your .ma Domain?</h2>
            <p class="cta-subtitle">Get your domain today through Hostino, a trusted registrar providing an officially compliant process, instant setup, and premium trilingual support.</p>
            <a href="https://hostino.ma/" target="_blank" class="btn btn-primary btn-large btn-shadow">Register on Hostino.ma</a>
        </div>
    </div>
</section>

<style>
    .cta-section {
        padding-top: 2rem;
    }

    .cta-box {
        background-color: var(--color-bg);
        border: 2px solid var(--color-border);
        border-radius: var(--border-radius);
        padding: 5rem 2rem;
        position: relative;
        overflow: hidden;
    }
    
    .cta-box::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 6px;
        background: var(--color-primary);
    }

    .cta-title {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 1rem;
        color: var(--color-text);
    }

    .cta-subtitle {
        font-size: 1.25rem;
        color: var(--color-text-muted);
        max-width: 700px;
        margin: 0 auto 2.5rem auto;
    }

    .btn-large {
        padding: 1.25rem 2.5rem;
        font-size: 1.25rem;
    }

    .btn-shadow {
        box-shadow: 0 10px 15px -3px rgba(81, 112, 255, 0.3), 0 4px 6px -2px rgba(81, 112, 255, 0.15);
    }
    
    .btn-shadow:hover {
        box-shadow: 0 15px 20px -3px rgba(81, 112, 255, 0.4), 0 4px 6px -2px rgba(81, 112, 255, 0.2);
        transform: translateY(-2px);
    }

    .text-center {
        text-align: center;
    }
    
    @media (max-width: 768px) {
        .cta-title {
            font-size: 2rem;
        }
        .cta-box {
            padding: 3rem 1.5rem;
        }
    }
</style>
